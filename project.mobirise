                "@media (max-width: 767px)": {
                  "grid-row-gap": "1rem"
                }
              },
              ".grid-container-1, .grid-container-2, .grid-container-3": {
                "gap": "0 2rem",
                "@media (max-width: 767px)": {
                  "gap": "0 1rem"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#04492e",
              "text-align": "center"
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".container, .container-fluid": {
              "overflow": "hidden"
            },
            ".grid-container": {
              "display": "grid",
              "transform": "translate3d(-3rem, 0, 0)",
              "width": "115vw",
              "grid-column-gap": "1rem"
            },
            ".grid-item": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center"
            },
            ".grid-item img": {
              "@media (max-width: 1200px)": {
                "height": "300px"
              },
              "@media (max-width: 767px)": {
                "min-width": "35vw",
                "height": "150px"
              },
              "min-width": "30vw",
              "max-width": "100%",
              "height": "420px",
              "object-fit": "cover",
              "border": "3px solid @border",
              "background-color": "@border",
              "border-radius": "2rem"
            },
            ".grid-container-1, .grid-container-2, .grid-container-3": {
              "display": "grid",
              "grid-template-columns": "repeat(4, 1fr)",
              "grid-auto-columns": "1fr",
              "grid-auto-flow": "column"
            },
            ".grid-container-1": {
              "align-items": "flex-end"
            },
            ".grid-container-2": {
              "align-items": "flex-start"
            }
          },
          "_name": "gallery01",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1\" group=\"Gallery & Slider\" plugins=\"scrollGallery\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" title=\"Reverse direction\" name=\"movingLeft\">\n        <input type=\"color\" title=\"Border Color\" value=\"#04492e\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" parallax name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#dcd7d0\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#edefeb\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container-fluid gallery-wrapper\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 content-head\">\n                <div class=\"mbr-section-head\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style mb-5\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Publish your site or preview it to see how the slider\n                        works in action.</b></h4>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid-container\">\n            <div class=\"grid-container-3\" mbr-class=\"{'moving-left': movingLeft}\" style=\"transform: translate3d(-200px, 0px, 0px);\">\n                <div class=\"grid-item\">\n                    <img src=\"../_images/features/features1.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"../_images/features/features2.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"../_images/features/features3.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n                <div class=\"grid-item\">\n                    <img src=\"../_images/features/features4.jpg\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uTN3eI4iBA",
          "_anchor": "gallery01-5s",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n\n\n\n  <meta charset=\"UTF-8\">\n  <title>Hebrew Alef-Bet Flash Cards</title>\n  <style>\n    body {\n      background: #fdf6e3;\n      font-family: \"Segoe UI\", sans-serif;\n      text-align: center;\n      padding: 2em;\n    }\n    .card {\n      display: none;\n      font-size: 5em;\n      font-family: \"David Libre\", \"Frank Ruhl Libre\", serif;\n      margin: 2em auto;\n      padding: 1em;\n      border: 2px solid #ccc;\n      border-radius: 12px;\n      background: #fff;\n      box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n      width: 200px;\n    }\n    .label {\n      font-size: 1.5em;\n      margin-top: 0.5em;\n    }\n  </style>\n\n\n  <h1>📜 Hebrew Alef-Bet Flash Cards</h1>\n\n  <div id=\"card-container\">\n    <!-- Cards will be injected here -->\n  </div>\n\n  [JS_CODE_0]\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-5r",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n    const letters = [\n      { symbol: \"א\", name: \"Alef\", sound: \"audio/alef.mp3\" },\n      { symbol: \"ב\", name: \"Bet\", sound: \"audio/bet.mp3\" },\n      { symbol: \"ג\", name: \"Gimel\", sound: \"audio/gimel.mp3\" },\n      { symbol: \"ד\", name: \"Dalet\", sound: \"audio/dalet.mp3\" },\n      // Add all 22 letters here...\n    ];\n\n    const container = document.getElementById(\"card-container\");\n\n    letters.forEach((letter, index) => {\n      const card = document.createElement(\"div\");\n      card.className = \"card\";\n      card.id = `card-${index}`;\n      card.innerHTML = `\n        <div>${letter.symbol}</div>\n        <div class=\"label\">${letter.name}</div>\n        <audio id=\"audio-${index}\" src=\"${letter.sound}\"></audio>\n      `;\n      container.appendChild(card);\n    });\n\n    let current = 0;\n    function showNextCard() {\n      if (current > 0) {\n        document.getElementById(`card-${current - 1}`).style.display = \"none\";\n      }\n      if (current < letters.length) {\n        const card = document.getElementById(`card-${current}`);\n        card.style.display = \"block\";\n        const audio = document.getElementById(`audio-${current}`);\n        audio.play();\n        current++;\n        setTimeout(showNextCard, 3000); // 3 seconds per card\n      }\n    }\n\n    showNextCard();\n  </script>"
          ]
        },
        {
