        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".list-group-item": {
              "background-color": "transparent",
              "color": "#04492e",
              "text-align": "left"
            },
            ".row-color": {
              "background": "@card",
              "border-radius": "2rem",
              "margin": "0"
            },
            ".card": {
              "padding": "0"
            },
            ".plan": {
              "padding": "3rem 2rem",
              "word-break": "break-word",
              "border-radius": "10px",
              ".list-group-item": {
                "position": "relative",
                "justify-content": "center",
                "padding-left": "2rem",
                "border": "0",
                "font-family": "'Moririse2' !important",
                "&::before": {
