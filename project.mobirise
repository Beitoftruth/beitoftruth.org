        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "\n[JS_CODE_0]",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-8f",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\nwindow.onload = function() {\n\n  async function loadParshiot() {\n    const response = await fetch('parshiot.json');\n    const data = await response.json();\n    return data.parshiot; // <-- FIXED FOR B2\n  }\n\n  function parseDate(str) {\n    const [mm, dd, yyyy] = str.split('-');\n    return new Date(`${yyyy}-${mm}-${dd}T00:00:00`);\n  }\n\n  function findCurrentParsha(parshiot) {\n    const today = new Date();\n\n    for (let p of parshiot) {\n      const pDate = parseDate(p.date);\n      if (pDate >= today) {\n        return p;\n      }\n    }\n\n    return parshiot[0];\n  }\n\n  function renderParsha(parsha) {\n    const container = document.getElementById('parsha-container');\n\n    container.innerHTML = `\n      <div class=\"parsha-card\">\n        <div class=\"parsha-date\">${parsha.date}</div>\n        <div class=\"hebrew\">${parsha.nameHe}</div>\n        <div class=\"bigger\">${parsha.nameEn}</div>\n\n        <p><strong>Torah:</strong> ${parsha.torah}</p>\n        <p><strong>Haftarah:</strong> ${parsha.haftarah}</p>\n        <p><strong>Brit Chadashah:</strong> ${parsha.brit}</p>\n      </div>\n    `;\n  }\n\n  loadParshiot().then(parshiot => {\n    const current = findCurrentParsha(parshiot);\n    renderParsha(current);\n  });\n\n};\n</script>"
          ]
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<h1>Parsha Readings</h1>\n\n<div id=\"parsha-container\"></div>\n<div id=\"custom-html-8g\">\n<style>\n  body {\n    background-color: #000000;\n    font-family: Arial, sans-serif;\n    margin: 0;\n    padding: 0;\n  }\n\n  h1 {\n    color: #ffffff;\n    text-align: center;\n    margin-top: 20px;\n  }\n\n  .parsha-card {\n    background: #ffffff;\n    border-radius: 1rem;\n    padding: 1.5rem;\n    margin: 1.5rem auto;\n    max-width: 900px;\n    box-shadow: 0 2px 6px rgba(0,0,0,0.2);\n  }\n\n  .parsha-date {\n    text-align: center;\n    font-style: italic;\n    margin-bottom: 0.5rem;\n  }\n\n  .hebrew {\n    font-weight: bold;\n    font-size: 275%;\n    text-align: center;\n  }\n\n  .bigger {\n    font-weight: bold;\n    font-size: 225%;\n    text-align: center;\n  }\n\n  p {\n    font-size: 120%;\n    line-height: 1.4;\n  }\n</style>\n\n[JS_CODE_0]</div>",
          "_customCSS": "body {\n  background-color: #000000;\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 0;\n}\n\nh1 {\n  color: #ffffff;\n  text-align: center;\n  margin-top: 20px;\n}\n\n.parsha-card {\n  background: #ffffff;\n  border-radius: 1rem;\n  padding: 1.5rem;\n  margin: 1.5rem auto;\n  max-width: 900px;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.2);\n}\n\n.parsha-date {\n  text-align: center;\n  font-style: italic;\n  margin-bottom: 0.5rem;\n}\n\n.hebrew {\n  font-weight: bold;\n  font-size: 275%;\n  text-align: center;\n}\n\n.bigger {\n  font-weight: bold;\n  font-size: 225%;\n  text-align: center;\n}\n\np {\n  font-size: 120%;\n  line-height: 1.4;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-8g",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\nwindow.onload = function() {\n\n  async function loadParshiot() {\n    const response = await fetch('parshiot.json');\n    return await response.json();\n  }\n\n  function parseDate(str) {\n    // str = \"MM-DD-YYYY\"\n    const [mm, dd, yyyy] = str.split('-');\n    return new Date(`${yyyy}-${mm}-${dd}T00:00:00`);\n  }\n\n  function findCurrentParsha(parshiot) {\n    const today = new Date();\n\n    for (let p of parshiot) {\n      const pDate = parseDate(p.date);\n      if (pDate >= today) {\n        return p;\n      }\n    }\n\n    // If we passed the last parsha, return Bereshit\n    return parshiot[0];\n  }\n\n  function renderParsha(parsha) {\n    const container = document.getElementById('parsha-container');\n\n    container.innerHTML = `\n      <div class=\"parsha-card\">\n        <div class=\"parsha-date\">${parsha.date}</div>\n        <div class=\"hebrew\">${parsha.nameHe}</div>\n        <div class=\"bigger\">${parsha.nameEn}</div>\n\n        <p><strong>Torah:</strong> ${parsha.torah}</p>\n        <p><strong>Haftarah:</strong> ${parsha.haftarah}</p>\n        <p><strong>Brit Chadashah:</strong> ${parsha.brit}</p>\n      </div>\n    `;\n  }\n\n  loadParshiot().then(parshiot => {\n    const current = findCurrentParsha(parshiot);\n    renderParsha(current);\n  });\n\n};\n</script>"
          ]
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "\n\n\n  <meta charset=\"UTF-8\">\n  <title>Parasha Readings – Tzav to V’Zot HaBerachah</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      margin: 0;\n      padding: 15px;\n      background: #f5f5f5;\n    }\n\n    #parasha-plan {\n      max-width: 900px;\n      margin: auto;\n    }\n\n    .parasha {\n      background: #ffffff;\n      padding: 18px;\n      margin-bottom: 20px;\n      border-radius: 10px;\n      box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n    }\n\n    .hebrew {\n      font-size: 1.6rem;\n      font-weight: bold;\n      direction: rtl;\n      text-align: right;\n    }\n\n    .translit {\n      font-size: 1.1rem;\n      font-style: italic;\n      margin-top: 4px;\n    }\n\n    .english {\n      font-size: 1rem;\n      margin-bottom: 10px;\n    }\n\n    .date {\n      font-weight: bold;\n      margin-bottom: 10px;\n    }\n\n    .refs p {\n      margin: 2px 0;\n    }\n\n    ol {\n      padding-left: 20px;\n      margin-top: 8px;\n    }\n\n    @media (max-width: 600px) {\n      .parasha {\n        padding: 15px;\n      }\n      .hebrew {\n        font-size: 1.4rem;\n      }\n    }\n  </style>\n\n\n<section id=\"parasha-plan\">\n\n  <!-- Tzav -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">צַו</div>\n    <div class=\"translit\">Tzav</div>\n    <div class=\"english\">“Command”</div>\n    <div class=\"date\">Shabbat: 03/28/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Leviticus 6:1–8:36</p>\n      <p><strong>Haftarah:</strong> Malachi 3:4–24</p>\n      <p><strong>Apostolic:</strong> Matthew 17:9–13</p>\n    </div>\n    <ol>\n      <li>What does the continual fire on the altar teach about ongoing devotion?</li>\n      <!--li>How do the priestly responsibilities picture a “royal priesthood” today?</li -->\n      <li>How do Malachi and Matthew connect repentance, sacrifice, and restoration?</li>\n    </ol>\n  </article>\n\n  <!-- Shemini -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">שְּׁמִינִי</div>\n    <div class=\"translit\">Shemini</div>\n    <div class=\"english\">“Eighth”</div>\n    <div class=\"date\">Shabbat: 04/04/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Leviticus 9:1–11:47</p>\n      <p><strong>Haftarah:</strong> 2 Samuel 6:1–7:17</p>\n      <p><strong>Apostolic:</strong> Acts 10:9–28</p>\n    </div>\n    <ol>\n      <li>What went wrong with Nadav and Avihu, and what does that teach about reverence?</li>\n      <li>How do the food instructions shape Israel’s identity as set apart?</li>\n      <li>How does Peter’s vision in Acts 10 reframe holiness and people?</li>\n    </ol>\n  </article>\n\n  <!-- Tazria–Metzora -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">תַזְרִיעַ – מְּצֹרָע</div>\n    <div class=\"translit\">Tazria – Metzora</div>\n    <div class=\"english\">“She Bears Seed” – “Leper”</div>\n    <div class=\"date\">Shabbat: 04/11/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Leviticus 12:1–15:33</p>\n      <p><strong>Haftarah:</strong> 2 Kings 4:42–5:19</p>\n      <p><strong>Apostolic:</strong> Luke 17:11–19</p>\n    </div>\n    <ol>\n      <li>How do the purity laws protect both family and community?</li>\n      <li>What does the priest’s role in diagnosis and restoration reveal about leadership?</li>\n      <li>How do Naaman and the healed lepers model faith and gratitude?</li>\n    </ol>\n  </article>\n\n  <!-- Acharei Mot–Kedoshim -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">אַחֲרֵי מוֹת – קְדֹשִׁים</div>\n    <div class=\"translit\">Acharei Mot – Kedoshim</div>\n    <div class=\"english\">“After the Death” – “Holy Ones”</div>\n    <div class=\"date\">Shabbat: 04/18/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Leviticus 16:1–20:27</p>\n      <p><strong>Haftarah:</strong> Ezekiel 22:1–19</p>\n      <p><strong>Apostolic:</strong> Hebrews 9:1–28</p>\n    </div>\n    <ol>\n      <li>How does Yom Kippur in this portion frame atonement for the whole nation?</li>\n      <li>Why are boundaries around worship, sexuality, and justice so strongly emphasized?</li>\n      <li>How does Hebrews describe Yeshua’s work in light of the Day of Atonement?</li>\n    </ol>\n  </article>\n\n  <!-- Emor -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">אֱמֹר</div>\n    <div class=\"translit\">Emor</div>\n    <div class=\"english\">“Speak”</div>\n    <div class=\"date\">Shabbat: 04/25/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Leviticus 21:1–24:23</p>\n      <p><strong>Haftarah:</strong> Ezekiel 44:15–31</p>\n      <p><strong>Apostolic:</strong> Luke 6:1–11</p>\n    </div>\n    <ol>\n      <li>What higher standards are placed on priests, and why?</li>\n      <li>How do the appointed times shape Israel’s yearly rhythm with God?</li>\n      <li>How does Yeshua’s teaching and actions on Shabbat relate to these mo’edim?</li>\n    </ol>\n  </article>\n\n  <!-- Behar–Bechukotai -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">בְּהַר – בְּחֻקֹּתַי</div>\n    <div class=\"translit\">Behar – Bechukotai</div>\n    <div class=\"english\">“On the Mountain” – “In My Statutes”</div>\n    <div class=\"date\">Shabbat: 05/02/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Leviticus 25:1–27:34</p>\n      <p><strong>Haftarah:</strong> Jeremiah 32:6–27</p>\n      <p><strong>Apostolic:</strong> Luke 4:16–21</p>\n    </div>\n    <ol>\n      <li>How do the Sabbatical and Jubilee years reshape economics and land ownership?</li>\n      <li>What does it mean that the land ultimately belongs to God?</li>\n      <li>How does Yeshua’s proclamation in Nazareth sound like a Jubilee announcement?</li>\n    </ol>\n  </article>\n\n  <!-- Bamidbar -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">בְּמִדְבַּר</div>\n    <div class=\"translit\">Bamidbar</div>\n    <div class=\"english\">“In the Wilderness”</div>\n    <div class=\"date\">Shabbat: 05/09/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 1:1–4:20</p>\n      <p><strong>Haftarah:</strong> Hosea 2:1–22</p>\n      <p><strong>Apostolic:</strong> Revelation 7:1–17</p>\n    </div>\n    <ol>\n      <li>Why is numbering the tribes important at this stage of Israel’s journey?</li>\n      <li>How does the camp’s arrangement around the Mishkan picture God’s presence?</li>\n      <li>How do Hosea and Revelation speak of God’s people being counted and restored?</li>\n    </ol>\n  </article>\n\n  <!-- Nasso -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">נָשֹׂא</div>\n    <div class=\"translit\">Nasso</div>\n    <div class=\"english\">“Lift Up”</div>\n    <div class=\"date\">Shabbat: 05/16/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 4:21–7:89</p>\n      <p><strong>Haftarah:</strong> Judges 13:2–25</p>\n      <p><strong>Apostolic:</strong> Luke 1:5–23</p>\n    </div>\n    <ol>\n      <li>What stands out to you in the Nazirite vow and the priestly blessing?</li>\n      <li>How do the tribal offerings show unity and generosity?</li>\n      <li>How do the birth stories of Samson and John the Immerser echo each other?</li>\n    </ol>\n  </article>\n\n  <!-- Beha'alotcha -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">בְּהַעֲלֹתְךָ</div>\n    <div class=\"translit\">Beha’alotcha</div>\n    <div class=\"english\">“When You Light”</div>\n    <div class=\"date\">Shabbat: 05/23/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 8:1–12:16</p>\n      <p><strong>Haftarah:</strong> Zechariah 2:14–4:7</p>\n      <p><strong>Apostolic:</strong> John 8:12–20</p>\n    </div>\n    <ol>\n      <li>How does the menorah imagery speak to Israel’s calling?</li>\n      <li>What do the complaints in this portion reveal about the people’s heart?</li>\n      <li>How does Yeshua’s claim to be the light of the world connect here?</li>\n    </ol>\n  </article>\n\n  <!-- Shelach -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">שְׁלַח־לְךָ</div>\n    <div class=\"translit\">Shelach</div>\n    <div class=\"english\">“Send”</div>\n    <div class=\"date\">Shabbat: 05/30/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 13:1–15:41</p>\n      <p><strong>Haftarah:</strong> Joshua 2:1–24</p>\n      <p><strong>Apostolic:</strong> Hebrews 3:7–19</p>\n    </div>\n    <ol>\n      <li>What distinguished the faithful report from the fearful one?</li>\n      <li>How did Israel’s response shape their destiny in the wilderness?</li>\n      <li>How does Hebrews warn us against the same kind of unbelief?</li>\n    </ol>\n  </article>\n\n  <!-- Korach -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">קֹרַח</div>\n    <div class=\"translit\">Korach</div>\n    <div class=\"english\">“Korah”</div>\n    <div class=\"date\">Shabbat: 06/06/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 16:1–18:32</p>\n      <p><strong>Haftarah:</strong> 1 Samuel 11:14–12:22</p>\n      <p><strong>Apostolic:</strong> Jude 1:8–16</p>\n    </div>\n    <ol>\n      <li>What was at the root of Korach’s rebellion?</li>\n      <li>How does God vindicate His chosen leadership?</li>\n      <li>How does Jude use Korach as a warning for communities of faith?</li>\n    </ol>\n  </article>\n\n  <!-- Chukat -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">חֻקַּת</div>\n    <div class=\"translit\">Chukat</div>\n    <div class=\"english\">“Statute”</div>\n    <div class=\"date\">Shabbat: 06/13/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 19:1–22:1</p>\n      <p><strong>Haftarah:</strong> Judges 11:1–33</p>\n      <p><strong>Apostolic:</strong> John 3:9–21</p>\n    </div>\n    <ol>\n      <li>What does the red heifer teach about purity and paradox?</li>\n      <li>How does Moses’ striking the rock affect his future?</li>\n      <li>How does the bronze serpent point toward Yeshua’s lifting up?</li>\n    </ol>\n  </article>\n\n  <!-- Balak -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">בָּלָק</div>\n    <div class=\"translit\">Balak</div>\n    <div class=\"english\">“Balak”</div>\n    <div class=\"date\">Shabbat: 06/20/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 22:2–25:9</p>\n      <p><strong>Haftarah:</strong> Micah 5:6–6:8</p>\n      <p><strong>Apostolic:</strong> Revelation 2:12–17</p>\n    </div>\n    <ol>\n      <li>How does God turn Balak’s curses into blessings?</li>\n      <li>What subtle strategy is used to lead Israel into sin?</li>\n      <li>How does Micah summarize what God truly requires?</li>\n    </ol>\n  </article>\n\n  <!-- Pinchas -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">פִּינְחָס</div>\n    <div class=\"translit\">Pinchas</div>\n    <div class=\"english\">“Phinehas”</div>\n    <div class=\"date\">Shabbat: 06/27/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 25:10–30:1</p>\n      <p><strong>Haftarah:</strong> 1 Kings 18:46–19:21</p>\n      <p><strong>Apostolic:</strong> Romans 11:25–36</p>\n    </div>\n    <ol>\n      <li>Why is Pinchas given a covenant of peace after a violent act?</li>\n      <li>How do the census and inheritance laws prepare Israel for the Land?</li>\n      <li>How does Elijah’s story speak to zeal, discouragement, and God’s gentle voice?</li>\n    </ol>\n  </article>\n\n  <!-- Matot–Masei -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">מַטּוֹת – מַסְעֵי</div>\n    <div class=\"translit\">Matot – Masei</div>\n    <div class=\"english\">“Tribes” – “Journeys”</div>\n    <div class=\"date\">Shabbat: 07/04/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Numbers 30:2–36:13</p>\n      <p><strong>Haftarah:</strong> Jeremiah 2:4–28; 3:4</p>\n      <p><strong>Apostolic:</strong> Hebrews 11:8–16</p>\n    </div>\n    <ol>\n      <li>What do Israel’s recorded journeys reveal about God’s faithfulness?</li>\n      <li>How do the cities of refuge picture justice and mercy together?</li>\n      <li>How does Hebrews describe the pilgrim mindset of God’s people?</li>\n    </ol>\n  </article>\n\n  <!-- Devarim -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">דְּבָרִים</div>\n    <div class=\"translit\">Devarim</div>\n    <div class=\"english\">“Words”</div>\n    <div class=\"date\">Shabbat: 07/11/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 1:1–3:22</p>\n      <p><strong>Haftarah:</strong> Isaiah 1:1–27</p>\n      <p><strong>Apostolic:</strong> Matthew 4:1–11</p>\n    </div>\n    <ol>\n      <li>Why does Moses retell Israel’s history before entering the Land?</li>\n      <li>What failures and lessons does he highlight for the new generation?</li>\n      <li>How does Yeshua’s use of Deuteronomy in the wilderness model obedience?</li>\n    </ol>\n  </article>\n\n  <!-- Va'etchanan -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">וָאֶתְחַנַּן</div>\n    <div class=\"translit\">Va’etchanan</div>\n    <div class=\"english\">“I Pleaded”</div>\n    <div class=\"date\">Shabbat: 07/18/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 3:23–7:11</p>\n      <p><strong>Haftarah:</strong> Isaiah 40:1–26</p>\n      <p><strong>Apostolic:</strong> Mark 12:28–34</p>\n    </div>\n    <ol>\n      <li>What do the Ten Words and the Shema reveal about covenant loyalty?</li>\n      <li>How does Moses warn against forgetting God in prosperity?</li>\n      <li>How does Yeshua summarize the greatest commandments from this portion?</li>\n    </ol>\n  </article>\n\n  <!-- Eikev -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">עֵקֶב</div>\n    <div class=\"translit\">Eikev</div>\n    <div class=\"english\">“Because”</div>\n    <div class=\"date\">Shabbat: 07/25/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 7:12–11:25</p>\n      <p><strong>Haftarah:</strong> Isaiah 49:14–51:3</p>\n      <p><strong>Apostolic:</strong> Ephesians 2:11–22</p>\n    </div>\n    <ol>\n      <li>How are obedience, blessing, and humility woven together here?</li>\n      <li>What dangers does Moses see in Israel’s future success?</li>\n      <li>How does Paul describe Gentiles being brought into God’s covenant people?</li>\n    </ol>\n  </article>\n\n  <!-- Re'eh -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">רְאֵה</div>\n    <div class=\"translit\">Re’eh</div>\n    <div class=\"english\">“See”</div>\n    <div class=\"date\">Shabbat: 08/01/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 11:26–16:17</p>\n      <p><strong>Haftarah:</strong> Isaiah 54:11–55:5</p>\n      <p><strong>Apostolic:</strong> 2 Corinthians 6:14–7:1</p>\n    </div>\n    <ol>\n      <li>How does Moses set before Israel the choice of blessing and curse?</li>\n      <li>What does centralized worship mean for Israel’s life together?</li>\n      <li>How do the festival instructions shape communal joy and generosity?</li>\n    </ol>\n  </article>\n\n  <!-- Shoftim -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">שֹׁפְטִים</div>\n    <div class=\"translit\">Shoftim</div>\n    <div class=\"english\">“Judges”</div>\n    <div class=\"date\">Shabbat: 08/08/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 16:18–21:9</p>\n      <p><strong>Haftarah:</strong> Isaiah 51:12–52:12</p>\n      <p><strong>Apostolic:</strong> Romans 13:1–10</p>\n    </div>\n    <ol>\n      <li>What principles of justice and leadership stand out in this portion?</li>\n      <li>How do the instructions about kings guard against abuse of power?</li>\n      <li>How should God’s standards shape our view of earthly authorities?</li>\n    </ol>\n  </article>\n\n  <!-- Ki Teitzei -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">כִּי־תֵצֵא</div>\n    <div class=\"translit\">Ki Teitzei</div>\n    <div class=\"english\">“When You Go Out”</div>\n    <div class=\"date\">Shabbat: 08/15/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 21:10–25:19</p>\n      <p><strong>Haftarah:</strong> Isaiah 54:1–10</p>\n      <p><strong>Apostolic:</strong> Galatians 3:10–14; 5:13–26</p>\n    </div>\n    <ol>\n      <li>How do these many “everyday” laws protect the vulnerable and maintain holiness?</li>\n      <li>Which command in this portion challenges you the most in practical life?</li>\n      <li>How does Paul contrast life in the flesh with life in the Spirit in light of Torah?</li>\n    </ol>\n  </article>\n\n  <!-- Ki Tavo -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">כִּי־תָבוֹא</div>\n    <div class=\"translit\">Ki Tavo</div>\n    <div class=\"english\">“When You Come In”</div>\n    <div class=\"date\">Shabbat: 08/22/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 26:1–29:8</p>\n      <p><strong>Haftarah:</strong> Isaiah 60:1–22</p>\n      <p><strong>Apostolic:</strong> Luke 10:1–16</p>\n    </div>\n    <ol>\n      <li>How do the firstfruits declaration and blessings shape Israel’s gratitude?</li>\n      <li>What do the curses teach about covenant responsibility?</li>\n      <li>How does Yeshua’s sending of the seventy echo themes of mission and accountability?</li>\n    </ol>\n  </article>\n\n  <!-- Nitzavim -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">נִצָּבִים</div>\n    <div class=\"translit\">Nitzavim</div>\n    <div class=\"english\">“Standing”</div>\n    <div class=\"date\">Shabbat: 08/29/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 29:9–30:20</p>\n      <p><strong>Haftarah:</strong> Isaiah 61:10–63:9</p>\n      <p><strong>Apostolic:</strong> Romans 10:1–13</p>\n    </div>\n    <ol>\n      <li>What does it mean that the word is “very near” to Israel?</li>\n      <li>How does Moses set life and death, blessing and curse before the people?</li>\n      <li>How does Paul use this passage to speak of faith and confession?</li>\n    </ol>\n  </article>\n\n  <!-- Vayelech -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">וַיֵּלֶךְ</div>\n    <div class=\"translit\">Vayelech</div>\n    <div class=\"english\">“And He Went”</div>\n    <div class=\"date\">Shabbat: 09/05/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 31:1–30</p>\n      <p><strong>Haftarah:</strong> Hosea 14:2–10; Micah 7:18–20; Joel 2:15–27 (Selichot themes)</p>\n      <p><strong>Apostolic:</strong> 2 Timothy 4:1–8</p>\n    </div>\n    <ol>\n      <li>How does Moses prepare Israel and Joshua for leadership transition?</li>\n      <li>What is the role of the written Torah as a witness among the people?</li>\n      <li>How does Paul’s charge to Timothy echo faithfulness at the end of a leader’s life?</li>\n    </ol>\n  </article>\n\n  <!-- Ha'azinu -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">הַאֲזִינוּ</div>\n    <div class=\"translit\">Ha’azinu</div>\n    <div class=\"english\">“Give Ear”</div>\n    <div class=\"date\">Shabbat: 09/12/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 32:1–52</p>\n      <p><strong>Haftarah:</strong> 2 Samuel 22:1–51</p>\n      <p><strong>Apostolic:</strong> Revelation 15:1–4</p>\n    </div>\n    <ol>\n      <li>What key themes about God’s character and Israel’s history appear in the song of Ha’azinu?</li>\n      <li>How does this song function as both warning and hope?</li>\n      <li>How do David’s song and the song in Revelation echo these themes?</li>\n    </ol>\n  </article>\n\n  <!-- V'Zot HaBerachah -->\n  <article class=\"parasha\">\n    <div class=\"hebrew\">וְזֹאת הַבְּרָכָה</div>\n    <div class=\"translit\">V’Zot HaBerachah</div>\n    <div class=\"english\">“And This Is the Blessing”</div>\n    <div class=\"date\">Simchat Torah (Diaspora): 10/12/2026</div>\n    <div class=\"refs\">\n      <p><strong>Torah:</strong> Deuteronomy 33:1–34:12</p>\n      <p><strong>Haftarah:</strong> Joshua 1:1–18</p>\n      <p><strong>Apostolic:</strong> John 1:1–18</p>\n    </div>\n    <ol>\n      <li>What do Moses’ blessings reveal about each tribe’s calling and destiny?</li>\n      <li>How does the description of Moses’ death and legacy shape your view of leadership?</li>\n      <li>How do Joshua’s commissioning and John’s prologue both speak of continuity and new beginnings?</li>\n    </ol>\n  </article>\n\n</section>\n\n",
          "_customCSS": "<style>\n  body {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    padding: 15px;\n    background: #f5f5f5;\n  }\n\n  #parasha-plan {\n    max-width: 900px;\n    margin: auto;\n  }\n\n  .parasha {\n    background: white;\n    padding: 18px;\n    margin-bottom: 20px;\n    border-radius: 10px;\n    box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n  }\n\n  .parasha h2 {\n    margin-top: 0;\n    font-size: 1.4rem;\n    color: #333;\n  }\n\n  .hebrew {\n    font-size: 1.6rem;\n    font-weight: bold;\n    direction: rtl;\n    text-align: left;\n  }\n\n  .translit {\n    font-size: 1.1rem;\n    font-style: italic;\n    margin-top: 4px;\n  }\n\n  .english {\n    font-size: 1rem;\n    margin-bottom: 10px;\n  }\n\n  .date {\n    font-weight: bold;\n    margin-bottom: 10px;\n  }\n\n  @media (max-width: 600px) {\n    .parasha {\n      padding: 15px;\n    }\n    .parasha h2 {\n      font-size: 1.25rem;\n    }\n    .hebrew {\n      font-size: 1.4rem;\n    }\n  }\n</style>\n\n<section id=\"parasha-plan\">",
          "alias": "code-editor",
          "_tags": [
