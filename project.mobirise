          "_name": "features02",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"range\" inline title=\"Card\" name=\"card\" min=\"1\" max=\"4\" step=\"1\" value=\"3\">\n        <header>Color</header>\n        <input type=\"color\" title=\"Card\" name=\"bgCard\" value=\"#033b25\">\n\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-12\">\n\n\n                <h2 class=\"mbr-section-title mbr-fonts-style pb-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>\n\n                        Features</b></h2>\n            </div>\n\n            <div class=\"col-12 col-lg-3\">\n                <div class=\"wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                        \n                         <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"Our-Father.html\" data-app-placeholder=\"Type Text\">Click</a></div>\n                        <b>Our Father</b></h5>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-3\" mbr-if=\"card > 1\">\n                <div class=\"wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">  \n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"Daily-Prayers.html\" data-app-placeholder=\"Type Text\">Click</a>Click</div>\n                        <b>Prayers</b></h5>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-3\" mbr-if=\"card > 2\">\n                <div class=\"wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                         <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"gratitude.html\" data-app-placeholder=\"Type Text\">Click</a></div>\n                        <b>Gratitude</b></h5>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-3\" mbr-if=\"card > 3\">\n                <div class=\"wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                         <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"index.html\" data-app-placeholder=\"Type Text\">HOME</a></div>\n                        <b>Sales</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
