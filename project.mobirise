        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "border": "3px solid @primaryColor",
              "padding": "3rem",
              "border-radius": "2rem",
              "@media (max-width: 992px)": {
                "margin-bottom": "2rem"
              },
              "@media (max-width: 767px)": {
                "padding": "2rem 1rem"
              },
              ".mbr-section-subtitle2": {
                "background": "@primaryColor",
                "width": "fit-content",
                "border-radius": "2rem",
                "padding": "5px 1rem",
                "text-align": "left"
              },
              ".subtitle-wrap2": {
                "display": "inline-flex",
                "border-radius": "2rem",
                "padding": "0.5rem",
                "padding-bottom": "0",
                "padding-left": "20px",
                "background": "@secondaryColor",
                "flex-direction": "row",
                "width": "fit-content",
                "align-items": "center",
                "margin-bottom": "2rem",
                ".mbr-iconfont": {
                  "padding": "0 15px",
                  "padding-bottom": "8px",
                  "margin": "0",
                  "color": "@primaryColor",
                  "font-size": "1.5rem"
                }
              }
            },
            ".mbr-section-subtitle": {
              "background": "white",
              "color": "#ffffff",
              "width": "fit-content",
              "border-radius": "2rem",
              "padding": "5px 1rem",
              "text-align": "left"
            },
            ".subtitle-wrap": {
              "display": "inline-flex",
              "border-radius": "2rem",
              "padding": "0.5rem",
              "padding-bottom": "0",
              "background": "@primaryColor",
              "flex-direction": "row",
              "width": "fit-content",
              "align-items": "center",
              "margin-bottom": "2rem",
              ".mbr-iconfont": {
                "padding": "0 15px",
                "padding-bottom": "8px",
                "margin": "0",
                "color": "@secondaryColor",
                "font-size": "1.5rem"
              }
            },
            ".mbr-section-title": {
              "color": "#04492e"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#6e6e6e"
            },
            ".mbr-section-subtitle, .align-wrapper": {
              "color": "#04492e"
            },
            ".mbr-section-subtitle3, .align-wrapper2": {
              "color": "#04492e"
            },
            ".mbr-section-subtitle2, .align-wrapper2": {
              "color": "#ffffff"
            },
            ".mbr-section-cardtitle": {
              "color": "#04492e"
            },
            ".mbr-cardtext": {
              "color": "#6e6e6e"
            }
          },
          "_name": "features04",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\"  class=\"features4\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showcardSubitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showcardText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\">\n            <input type=\"color\" title=\"Color\" value=\"#e1e7e4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row  align-left {{contentAlign}}\">\n            <div class=\"col-12 col-lg-6 pb-5\">\n                <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                    <div class=\"subtitle-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-rocket mobi-mbri\"></span>\n                        <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>Process</b></h2>\n                    </div>\n                </div>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Grow Up</b></h1>\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Lorem ipsum consectetur adipiscing.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Create\n                        Website</a></div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"card-wrapper\">\n                    <div class=\"align-wrapper2\" mbr-if=\"showcardSubitle\">\n                        <div class=\"subtitle-wrap2\">\n                            <h2 class=\"mbr-section-subtitle3 mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle3, .align-wrapper2\" mbr-theme-style=\"display-4\" mbr-if=\"showcardSubitle\"><b>\n\n                                    Step 1</b></h2>\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                            <h2 class=\"mbr-section-subtitle2 mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle2, .align-wrapper2\" mbr-theme-style=\"display-4\" mbr-if=\"showcardSubitle\"><b>\n\n                                    1-2 weeks</b></h2>\n                        </div>\n                    </div>\n                    <h1 class=\"mbr-section-cardtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-cardtitle\" mbr-theme-style=\"display-5\"><b>Promotion</b></h1>\n                    <p class=\"mbr-cardtext mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showcardText\" data-app-selector=\".mbr-cardtext\">\n                        Lorem ipsum dolor sit amet consectetur adipiscing elit. Morbi a elit ante. Integer libero\n                        commodo eleifend.</p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
