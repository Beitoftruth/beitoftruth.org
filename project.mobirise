          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n    <h1 class=\"display-2\">Psalm 119:159-60 CJB</h1>\n   <p class=\"display-3\">See how I love your precepts, ADONAI; in keeping with your grace, revive me. The main thing about your word is that it’s true; and all your just rulings last forever.</p>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}\nmargin-left: 12px;\n      margin-right: 12px;",
