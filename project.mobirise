        {
          "alias": false,
          "_styles": {},
          "_name": "header03",
          "_sourceTheme": "discretem5",
          "_customHTML": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Print Function Code</title>\n</head>\n<body>\n\n<h2>Function Code:</h2>\n<pre id=\"demo\"></pre> <!-- <pre> preserves formatting -->\n\n[JS_CODE_0]\n\n</body>\n</html>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n  function demo() {\n    return \"🕊️ Shalom, Kyle — your symbolic map is ready.\";\n  }\n\n  // Print the function's source code\n  document.getElementById(\"demo\").innerText = demo.toString();\n</script>"
          ],
          "_cid": "uTANs1cFQq",
          "_anchor": "header03-2f",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n\n\n  <meta charset=\"UTF-8\">\n  <title>Hebrew Alef-Bet with Sounds</title>\n  <style>\n    body {\n      font-family: \"Segoe UI\", sans-serif;\n      background: #fdf6e3;\n      color: #333;\n      text-align: center;\n      padding: 2em;\n    }\n    .letter-grid {\n      display: grid;\n      grid-template-columns: repeat(6, 1fr);\n      gap: 1em;\n      max-width: 800px;\n      margin: auto;\n    }\n    .letter-card {\n      background: #fff;\n      border: 1px solid #ccc;\n      border-radius: 8px;\n      padding: 1em;\n      box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    }\n    .hebrew {\n      font-size: 2em;\n      font-family: \"David Libre\", \"Frank Ruhl Libre\", serif;\n    }\n    audio {\n      margin-top: 0.5em;\n      width: 100%;\n    }\n  </style>\n\n\n  <h1>📜 Hebrew Alef-Bet with Pronunciation</h1>\n  <div class=\"letter-grid\">\n    <div class=\"letter-card\">\n      <div class=\"hebrew\">א</div>\n      <div>Alef</div>\n      <audio controls=\"\">\n        <source src=\"audio/alef.mp3\" type=\"audio/mpeg\">\n        Your browser does not support the audio element.\n      </audio>\n    </div>\n    <div class=\"letter-card\">\n      <div class=\"hebrew\">ב</div>\n      <div>Bet</div>\n      <audio controls=\"\">\n        <source src=\"audio/bet.mp3\" type=\"audio/mpeg\">\n      </audio>\n    </div>\n    <!-- Repeat for all 22 letters -->\n  </div>\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-2t",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
