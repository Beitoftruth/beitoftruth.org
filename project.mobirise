          "_anchor": "custom-html-8a",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".mbr-text": {
              "color": "#fafaf9"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".wrapper": {
              "background": "@bgCard",
              "padding": "3rem 1rem",
              "border-radius": "2rem",
              "margin-bottom": "2rem"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Card Width\" name=\"cardsWidth\">\n\t\t\t<option value=\"12\">Full-Width</option>\n\t\t\t<option value=\"6\">Wide</option>\n\t\t\t<option value=\"4\" selected>Standard</option>\n\t\t\t<option value=\"3\">Narrow</option>\n\t\t</select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"range\" inline title=\"Card\" name=\"card\" min=\"1\" max=\"4\" step=\"1\" value=\"4\">\n        <header>Color</header>\n        <input type=\"color\" title=\"Card\" name=\"bgCard\" value=\"#ffffff\">\n\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#6B9080\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-12\">\n            <h2 class=\"mbr-section-title mbr-fonts-style pb-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Features</b></h2>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"wrapper item-wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                        <b>Karaite</b>\n                    </h5>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"wrapper item-wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                        <b>Messianic</b>\n                    </h5>\n                </div>\n            </div><div class=\"item features-without-image col-12 col-md-6 col-lg-{{cardsWidth}}\">\n                <div class=\"wrapper item-wrapper\">\n                    <h5 class=\"mbr-section-title pt-2 mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                        <b>Fellowship</b>\n                    </h5>\n                </div>\n            </div>\n            \n            \n            \n        </div>\n    </div>\n</section>",
          "_name": "features02",
