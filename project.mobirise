        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value>Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fafaf9\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-left {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubitle\">Subtitle\n                </h2>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-5 pb-5\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>Beit Emet: House of Truth</b></h1>\n\n                <p class=\"mbr-text mbr-fonts-style mb-5 pt-5 mt-5\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Karaite Messianic Congregation in NW Indiana. Jewish &amp; Gentile believers in Yeshua. Find your community!</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"index.html#contact-form-1-uTi1XrXOrO\" data-app-placeholder=\"Type Text\">Join Us</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "header01",
          "_sourceTheme": "discretem5",
          "alias": false,
          "_cid": "uVyBqJzuEp",
          "_anchor": "header01-6t",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n    \n    <h1 class=\"display-3\">[JS_CODE_0]\n        [JS_CODE_1]\n    </h1><p>Verse of the Day</p>\n<!-- alternative for no javascript -->\n\n <div>\n\n    </div>\n\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 40px;\n  color: #777;\n}\n",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script width=\"100%\" height=\"200\" style=\"margin-left: 40px; margin-right: 40px; border: none;\"src=\"https://www.biblegateway.com/votd/votd.write.callback.js\"></script>",
            "<script src=\"https://www.biblegateway.com/votd/get/?format=json&version=CJB&callback=BG.votdWriteCallback\"></script>"
          ],
          "_anchor": "custom-html-6u"
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "\n\n\n  <meta charset=\"UTF-8\">\n  <title>Next 20 Parsha Readings</title>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }\n    h1 { text-align: center; }\n    .week { margin-bottom: 25px; padding: 10px; border-bottom: 1px solid #ccc; }\n    .date { font-weight: bold; color: #2a4d69; }\n    .theme { font-style: italic; color: #333; }\n  </style>\n\n\n  <h1>Next 20 Parsha Readings (Diaspora)</h1>\n\n  <!-- 1 -->\n  <div class=\"week\">\n    <div class=\"date\">Feb 21, 2026 — Parsha: Terumah</div>\n    <div>Torah: Exodus 25:1–27:19</div>\n    <div>Haftarah (Sephardi): 1 Kings 5:26–6:13</div>\n    <div>Haftarah (Karaite): Ezekiel 43:10–27</div>\n    <div>Messianic Reading: Hebrews 8–9</div>\n    <div class=\"theme\">Yeshua is the heavenly pattern behind the earthly Mishkan.</div>\n  </div>\n\n  <!-- 2 -->\n  <div class=\"week\">\n    <div class=\"date\">Feb 28, 2026 — Parsha: Tetzaveh</div>\n    <div>Torah: Exodus 27:20–30:10</div>\n    <div>Haftarah (Sephardi): Ezekiel 43:10–27</div>\n    <div>Haftarah (Karaite): Isaiah 61:1–11</div>\n    <div>Messianic Reading: Revelation 1:12–20</div>\n    <div class=\"theme\">Yeshua walks among the menorot as our eternal High Priest.</div>\n  </div>\n\n  <!-- 3 -->\n  <div class=\"week\">\n    <div class=\"date\">Mar 7, 2026 — Parsha: Ki Tisa</div>\n    <div>Torah: Exodus 30:11–34:35</div>\n    <div>Haftarah (Sephardi): 1 Kings 18:1–39</div>\n    <div>Haftarah (Karaite): Ezekiel 36:16–38</div>\n    <div>Messianic Reading: 2 Corinthians 3:7–18</div>\n    <div class=\"theme\">Yeshua removes the veil and reveals God’s glory.</div>\n  </div>\n\n  <!-- 4 -->\n  <div class=\"week\">\n    <div class=\"date\">Mar 14, 2026 — Parsha: Vayakhel–Pekudei</div>\n    <div>Torah: Exodus 35:1–40:38</div>\n    <div>Haftarah (Sephardi): 1 Kings 7:40–50</div>\n    <div>Haftarah (Karaite): Isaiah 66:1–24</div>\n    <div>Messianic Reading: Hebrews 9:1–14</div>\n    <div class=\"theme\">Yeshua fulfills the purpose of the completed Tabernacle.</div>\n  </div>\n\n  <!-- 5 -->\n  <div class=\"week\">\n    <div class=\"date\">Mar 21, 2026 — Parsha: Vayikra</div>\n    <div>Torah: Leviticus 1:1–5:26</div>\n    <div>Haftarah (Sephardi): Isaiah 43:21–44:23</div>\n    <div>Haftarah (Karaite): Jeremiah 7:21–8:3</div>\n    <div>Messianic Reading: Romans 12:1–2</div>\n    <div class=\"theme\">Yeshua calls us to become living sacrifices.</div>\n  </div>\n\n  <!-- 6 -->\n  <div class=\"week\">\n    <div class=\"date\">Mar 28, 2026 — Parsha: Tzav</div>\n    <div>Torah: Leviticus 6:1–8:36</div>\n    <div>Haftarah (Sephardi): Jeremiah 7:21–8:3</div>\n    <div>Haftarah (Karaite): Isaiah 57:14–58:14</div>\n    <div>Messianic Reading: Matthew 5:17–20</div>\n    <div class=\"theme\">Yeshua fulfills Torah and deepens its meaning.</div>\n  </div>\n\n  <!-- 7 -->\n  <div class=\"week\">\n    <div class=\"date\">Apr 11, 2026 — Parsha: Shemini</div>\n    <div>Torah: Leviticus 9:1–11:47</div>\n    <div>Haftarah (Sephardi): 2 Samuel 6:1–7:17</div>\n    <div>Haftarah (Karaite): Ezekiel 36:16–38</div>\n    <div>Messianic Reading: Mark 7:14–23</div>\n    <div class=\"theme\">Yeshua teaches purity from the inside out.</div>\n  </div>\n\n  <!-- 8 -->\n  <div class=\"week\">\n    <div class=\"date\">Apr 18, 2026 — Parsha: Tazria–Metzora</div>\n    <div>Torah: Leviticus 12:1–15:33</div>\n    <div>Haftarah (Sephardi): 2 Kings 7:3–20</div>\n    <div>Haftarah (Karaite): Isaiah 52:1–12</div>\n    <div>Messianic Reading: Luke 17:11–19</div>\n    <div class=\"theme\">Yeshua heals and restores the outcast.</div>\n  </div>\n\n  <!-- 9 -->\n  <div class=\"week\">\n    <div class=\"date\">Apr 25, 2026 — Parsha: Achrei Mot–Kedoshim</div>\n    <div>Torah: Leviticus 16:1–20:27</div>\n    <div>Haftarah (Sephardi): Amos 9:7–15</div>\n    <div>Haftarah (Karaite): Ezekiel 22:1–31</div>\n    <div>Messianic Reading: Hebrews 10:1–25</div>\n    <div class=\"theme\">Yeshua fulfills Yom Kippur and calls us to holiness.</div>\n  </div>\n\n  <!-- 10 -->\n  <div class=\"week\">\n    <div class=\"date\">May 2, 2026 — Parsha: Emor</div>\n    <div>Torah: Leviticus 21:1–24:23</div>\n    <div>Haftarah (Sephardi): Ezekiel 44:15–31</div>\n    <div>Haftarah (Karaite): Isaiah 56:1–8</div>\n    <div>Messianic Reading: John 10:22–30</div>\n    <div class=\"theme\">Yeshua is the Good Shepherd among His people.</div>\n  </div>\n\n  <!-- 11 -->\n  <div class=\"week\">\n    <div class=\"date\">May 9, 2026 — Parsha: Behar–Bechukotai</div>\n    <div>Torah: Leviticus 25:1–27:34</div>\n    <div>Haftarah (Sephardi): Jeremiah 32:6–27</div>\n    <div>Haftarah (Karaite): Ezekiel 34:1–31</div>\n    <div>Messianic Reading: Luke 4:16–21</div>\n    <div class=\"theme\">Yeshua proclaims the Jubilee of freedom.</div>\n  </div>\n\n  <!-- 12 -->\n  <div class=\"week\">\n    <div class=\"date\">May 16, 2026 — Parsha: Bamidbar</div>\n    <div>Torah: Numbers 1:1–4:20</div>\n    <div>Haftarah (Sephardi): Hosea 2:1–22</div>\n    <div>Haftarah (Karaite): Isaiah 40:1–26</div>\n    <div>Messianic Reading: Matthew 9:35–38</div>\n    <div class=\"theme\">Yeshua gathers and numbers His flock.</div>\n  </div>\n\n  <!-- 13 -->\n  <div class=\"week\">\n    <div class=\"date\">May 23, 2026 — Parsha: Naso</div>\n    <div>Torah: Numbers 4:21–7:89</div>\n    <div>Haftarah (Sephardi): Judges 13:2–25</div>\n    <div>Haftarah (Karaite): Isaiah 45:1–25</div>\n    <div>Messianic Reading: John 17</div>\n    <div class=\"theme\">Yeshua embodies the priestly blessing.</div>\n  </div>\n\n  <!-- 14 -->\n  <div class=\"week\">\n    <div class=\"date\">May 30, 2026 — Parsha: Beha’alotcha</div>\n    <div>Torah: Numbers 8:1–12:16</div>\n    <div>Haftarah (Sephardi): Zechariah 2:14–4:7</div>\n    <div>Haftarah (Karaite): Isaiah 60:1–22</div>\n    <div>Messianic Reading: Revelation 11:1–6</div>\n    <div class=\"theme\">Yeshua is the light that never goes out.</div>\n  </div>\n\n  <!-- 15 -->\n  <div class=\"week\">\n    <div class=\"date\">Jun 6, 2026 — Parsha: Shelach</div>\n    <div>Torah: Numbers 13:1–15:41</div>\n    <div>Haftarah (Sephardi): Joshua 2:1–24</div>\n    <div>Haftarah (Karaite): Isaiah 51:1–23</div>\n    <div>Messianic Reading: Hebrews 3–4</div>\n    <div class=\"theme\">Yeshua leads us into the true promised rest.</div>\n  </div>\n\n  <!-- 16 -->\n  <div class=\"week\">\n    <div class=\"date\">Jun 13, 2026 — Parsha: Korach</div>\n    <div>Torah: Numbers 16:1–18:32</div>\n    <div>Haftarah (Sephardi): 1 Samuel 11:14–12:22</div>\n    <div>Haftarah (Karaite): Isaiah 57:1–21</div>\n    <div>Messianic Reading: Jude 1–11</div>\n    <div class=\"theme\">Yeshua is the true, humble High Priest.</div>\n  </div>\n\n  <!-- 17 -->\n  <div class=\"week\">\n    <div class=\"date\">Jun 20, 2026 — Parsha: Chukat</div>\n    <div>Torah: Numbers 19:1–22:1</div>\n    <div>Haftarah (Sephardi): Judges 11:1–33</div>\n    <div>Haftarah (Karaite): Isaiah 63:7–19</div>\n    <div>Messianic Reading: John 3:14–21</div>\n    <div class=\"theme\">Yeshua is the lifted-up healer like the bronze serpent.</div>\n  </div>\n\n  <!-- 18 -->\n  <div class=\"week\">\n    <div class=\"date\">Jun 27, 2026 — Parsha: Balak</div>\n    <div>Torah: Numbers 22:2–25:9</div>\n    <div>Haftarah (Sephardi): Micah 5:6–6:8</div>\n    <div>Haftarah (Karaite): Isaiah 14:24–32</div>\n    <div>Messianic Reading: Revelation 2:12–17</div>\n    <div class=\"theme\">Yeshua overcomes every false prophecy and curse.</div>\n  </div>\n\n  <!-- 19 -->\n  <div class=\"week\">\n    <div class=\"date\">Jul 4, 2026 — Parsha: Pinchas</div>\n    <div>Torah: Numbers 25:10–30:1</div>\n    <div>Haftarah (Sephardi): 1 Kings 18:46–19:21</div>\n    <div>Haftarah (Karaite): Jeremiah 1:1–19</div>\n    <div>Messianic Reading: John 2:13–22</div>\n    <div class=\"theme\">Yeshua shows zeal for God’s house.</div>\n  </div>\n\n  <!-- 20 -->\n  <div class=\"week\">\n    <div class=\"date\">Jul 11, 2026 — Parsha: Matot–Masei</div>\n    <div>Torah: Numbers 30:2–36:13</div>\n    <div>Haftarah (Sephardi): Jeremiah 2:4–28; 3:4</div>\n    <div>Haftarah (Karaite): Isaiah 1:1–27</div>\n    <div>Messianic Reading: Hebrews 11:13–16</div>\n    <div class=\"theme\">Yeshua leads us on the final journey to the promised inheritance.</div>\n  </div>\n\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
