        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<div>\n    <h1 class=\"display-1\">Calendar</h1>\n    \n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"#777\" width=\"200\" height=\"50\"></svg>\n    <p class=\"display-3\"><iframe src=\"https://calendar.google.com/calendar/embed?src=ac4ekc1keemvd5leo2j9cttg74%40group.calendar.google.com&amp;ctz=America%2FChicago\" style=\"border: 0\" width=\"100%\" height=\"700\" frameborder=\"0\" scrolling=\"yes\"></iframe></p>\n</div>\n    <!--div class=\"mbr-section-head pb-4\" -->\n    <!-- /div -->  \n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
