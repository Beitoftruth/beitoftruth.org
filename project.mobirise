          "_name": "header03",
          "_sourceTheme": "discretem5",
          "_customHTML": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Print Function Code</title>\n</head>\n<body>\n\n<h2>Function Code:</h2>\n<pre id=\"demo\"></pre> <!-- <pre> preserves formatting -->\n\n[JS_CODE_0]\n\n</body>\n</html>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n  function demo() {\n    return \"🕊️ Shalom, Kyle — your symbolic map is ready.\";\n  }\n\n  // Print the function's source code\n  document.getElementById(\"demo\").innerText = demo.toString();\n</script>"
          ],
          "_cid": "uTBv6RVGac",
          "_anchor": "header03-30",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
