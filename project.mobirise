          "_name": "header02",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header2\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"7\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\">\n            <input type=\"color\" title=\"Color\" value=\"#04492e\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-left {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                    <div class=\"subtitle-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-edit-2 mobi-mbri\"></span>\n                        <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>\n\n                                Services</b></h2>\n                    </div>\n                </div>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Parsha Reading</b></h1>            \n            </div>\n        </div>\n    <!--/div -->\n    \n  <title>Weekly Parashah Readings</title>\n  \n  <title>Messianic Parashah Readings</title>\n    <!-- header -->\n    <h1>Messianic Parshah Readings</h1>\n        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                   Torah • Haftarah • Brit Chadashah</p>\n        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">If you see any dates for High Holies that is from the rabbinic calendar and SHOULD ONLY be used as a rough estimate. <br>We use the Moon to determine when a New Month begins and that tells Karaites when Holy Days will occur as per Leviticus 23.</p>\n   \n  <!--/header -->\n\n  <!--section class=\"parashah\">\n    <h2>Aug 16, 2025 – Parashat Ekev (Deuteronomy 7:12–11:25)</h2>\n    <p><strong>Theme:</strong> Blessings for obedience</p>\n    <p class=\"connection\">Messianic Connection: Yeshua echoes the call to wholehearted love and obedience (Matthew 22:37–40)</p>\n    <p class=\"reference\">Haftarah: Isaiah 49:14–51:3 | Brit Chadashah: Romans 8:31–39</p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Aug 23, 2025 – Parashat Re’eh (Deuteronomy 11:26–16:17)</h2>\n    <p><strong>Theme:</strong> Blessing and curse, worship, justice</p>\n    <p class=\"connection\">Messianic Connection: Yeshua as the true place of worship and justice (John 4:21–24)</p>\n    <p class=\"reference\">Haftarah: Isaiah 54:11–55:5 | Brit Chadashah: 1 Corinthians 5:9–13</p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Aug 30, 2025 – Parashat Shoftim (Deuteronomy 16:18–21:9)</h2>\n    <p><strong>Theme:</strong> Justice, leadership, prophetic authority</p>\n    <p class=\"connection\">Messianic Connection: Yeshua as the promised prophet like Moses (Deuteronomy 18:15; Acts 3:22–23)</p>\n    <p class=\"reference\">Haftarah: Isaiah 51:12–52:12 | Brit Chadashah: Matthew 3:1–17</p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Sep 6, 2025 – Parashat Ki Tetze (Deuteronomy 21:10–25:19)</h2>\n    <p><strong>Theme:</strong> Holiness in daily life, justice, compassion</p>\n    <p class=\"connection\">Messianic Connection: Yeshua’s teachings on mercy and purity (Matthew 5–7)</p>\n    <p class=\"reference\">Haftarah: Isaiah 54:1–10 | Brit Chadashah: 1 Corinthians 5:1–5</p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Sep 13, 2025 – Parashat Ki Tavo (Deuteronomy 26:1–29:8)</h2>\n    <p><strong>Theme:</strong> Covenant renewal, blessings and curses</p>\n    <p class=\"connection\">Messianic Connection: Yeshua bears the curse to bring blessing (Galatians 3:13–14)</p>\n    <p class=\"reference\">Haftarah: Isaiah 60:1–22 | Brit Chadashah: Luke 24:44–53</p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Sep 20, 2025 – Parashat Nitzavim (Deuteronomy 29:9–30:20)</h2>\n    <p><strong>Theme:</strong> Life and death, choice and renewal</p>\n    <p class=\"connection\">Messianic Connection: Yeshua as the way, the truth, and the life (John 14:6)</p>\n    <p class=\"reference\">Haftarah: Isaiah 61:10–63:9 | Brit Chadashah: Romans 10:1–17</p>\n  </section -->\n    \n  <!-- section class=\"parashah\">\n    <h2>Sep 27 – Parashat Vayeilech (Deut 31:1–30)</h2>\n    <p><strong>Theme:</strong> Leadership transition</p>\n    <p class=\"connection\">Messianic Connection: Yeshua commissions disciples to carry the Word (Matthew 28:18–20)</p>\n    <p class=\"reference\">Haftarah: Isaiah 55:6–56:8 | Brit Chadashah: John 15:1–11</p>\n  </section>\n\n     <section class=\"parashah\">\n    <h2>Oct 2 Before Sunset – Yom HaKippurim Readings</h2>\n    <p><strong>Theme:</strong> Atonement and repentance</p>\n    <p class=\"connection\">Messianic Connection: Messiah as High Priest and atoning sacrifice (2 Corinthians 5:10–21)</p>\n    <p class=\"reference\">Torah: Leviticus 16:1–34 | Haftarah: Isaiah 57:14–58:14 | Brit Chadashah: Romans 12:19</p>\n  </section>\n        \n  <section class=\"parashah\">\n    <h2>Oct 4 – Parashat Ha’Azinu (Deut 32:1–52)</h2>\n    <p><strong>Theme:</strong> Song of witness</p>\n    <p class=\"connection\">Messianic Connection: Yeshua fulfills the prophetic song as the Rock and Redeemer (Romans 10:17–11:12)</p>\n    <p class=\"reference\">Haftarah: 2 Samuel 22:1–51 | Brit Chadashah: Romans 15:9–10</p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Oct 7 at Sunset – Sukkot I (Leviticus 22:26–23:44)</h2>\n    <p><strong>Theme:</strong> Dwelling with God</p>\n    <p class=\"connection\">Messianic Connection: Yeshua tabernacled among us (John 1:14; Revelation 7:1–10)</p>\n    <p class=\"reference\">Haftarah: Zechariah 14:1–21 | Brit Chadashah: Revelation 7:1–10</p>\n  </section -->\n        \n   <!--section class=\"parashah\">\n    <h2>Oct 16 – Parashat Z'Vot HaBrachah (Deut 33:1–34:12)</h2>\n    <p><strong>Theme:</strong> Blessings and Transition</p>\n    <p class=\"connection\">Messianic Connection: Yeshua is Cohen HaGadol l'olam (Hebrews 7:24-28)</p>\n    <p class=\"reference\">Haftarah: Joshua 1:1-18 | Brit Chadashah: Romans 15:9–10</p>\n  </section>     \n\n  <section class=\"parashah\">\n    <h2>Oct 25 – at Parashat B'resheet (Genesis 1:1–6:8)</h2>\n    <p><strong>Theme:</strong> Creation and beginnings</p>\n    <p class=\"connection\">Messianic Connection: Yeshua as the Word through whom all was created (John 1:1–3)</p>\n    <p class=\"reference\">Haftarah: Isaiah 42:5–43:10 | Brit Chadashah: Revelation 22:6–21</p>\n  </section -->\n\n\n  <!--h1>Messianic Parashah Readings</h1>\n        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                   Torah • Haftarah • Brit Chadashah</p -->\n   \n\n  <!-- section class=\"parashah\">\n    <h2>Nov 1 – Parashat #2 Noach (Genesis 6:9–11:32)&nbsp;</h2>\n    <p><strong>Theme:</strong> Judgment and renewal</p>\n    <p class=\"connection\">Messianic Connection: The ark as a symbol of salvation through righteousness (1 Peter 3:20–21)</p>\n    <p class=\"reference\">Haftarah: Isaiah 54:1–55:5 | Brit Chadashah: Matthew 24:36–46<br>Psalms 2 and 104</p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Nov 8 – Parashat #3 Lech-Lecha (Genesis 12:1–17:27)</h2>\n    <p><strong>Theme:</strong> Covenant and calling</p>\n    <p class=\"connection\">Messianic Connection: Abraham’s faith prefigures justification through Messiah (Romans 4:1–25)</p>\n    <p class=\"reference\">Haftarah: Isaiah 40:27–41:16 | Brit Chadashah: Galatians 3:6–9<br>Psalm 3 and 105</p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Nov 15 – Parashat #4 Vayera (Genesis 18:1–22:24)</h2>\n    <p><strong>Theme:</strong> Divine visitation and testing</p>\n    <p class=\"connection\">Messianic Connection: Isaac as a type of Messiah’s sacrifice (Hebrews 11:17–19)</p>\n    <p class=\"reference\">Haftarah: 2 Kings 4:1–37 | Brit Chadashah: Luke 1:26–38<br>Psalm 15 and 4</p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Nov 22 – Parashat #5 Chayei Sarah (Genesis 23:1–25:18)</h2>\n    <p><strong>Theme:</strong> Legacy and covenant continuation</p>\n    <p class=\"connection\">Messianic Connection: The bride for Isaac as a picture of Messiah’s bride (Matthew 1:1–17)</p>\n    <p class=\"reference\">Haftarah: 1 Kings 1:1–31 | Brit Chadashah: Revelation 19:7–9<br>Psalm 23 and 5</p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Nov 29 – Parashat #6 Toldot (Genesis 25:19–28:9)</h2>\n    <p><strong>Theme:</strong> Generational struggle and blessing</p>\n    <p class=\"connection\">Messianic Connection: God’s sovereign choice in Messiah’s lineage (Romans 9:1–13)</p>\n    <p class=\"reference\">Haftarah: Malachi 1:1–2:7 | Brit Chadashah: Hebrews 12:14–17<br>Psalm 25 and 6</p>\n  </section-->\n\n  <!--section class=\"parashah\">\n    <h2>Dec 6 – Parashat #7 Vayetzei (Genesis 28:10–32:3)</h2>\n    <p><strong>Theme:</strong> Divine encounter and covenant expansion</p>\n    <p class=\"connection\">Messianic Connection: Jacob’s ladder as a picture of Yeshua bridging heaven and earth (John 1:51)</p>\n    <p class=\"reference\">Haftarah: Hosea 12:13–14:10 | Brit Chadashah: John 1:19–51<br>Psalm 91 and 7</p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Dec 6 – Parashat #8 Vayishlach (Genesis 32:4–36:43)</h2>\n    <p><strong>Theme:</strong> Reconciliation and transformation</p>\n    <p class=\"connection\">Messianic Connection: Jacob’s wrestling prefigures spiritual struggle and renewal in Messiah (Hebrews 11:11–20)</p>\n    <p class=\"reference\">Haftarah: Obadiah 1:1–21 | Brit Chadashah: Romans 12:1–2<br>Psalm 30 and 8</p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Dec 13 – Parashat #9 Vayeshev (Genesis 37:1–40:23)</h2>\n    <p><strong>Theme:</strong> Suffering and providence</p>\n    <p class=\"connection\">Messianic Connection: Joseph as a foreshadow of Messiah’s rejection and exaltation (Acts 7:9–10)</p>\n    <p class=\"reference\">Haftarah: Amos 2:6–3:8 | Brit Chadashah: Matthew 27:13–46<br>Psalm 105 and 9</p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Dec 20 – Parashat #10 Miketz (Genesis 41:1–44:17)</h2>\n    <p><strong>Theme:</strong> Redemption and revelation</p>\n    <p class=\"connection\">Messianic Connection: Joseph’s rise mirrors Messiah’s exaltation and provision (Luke 22:14–30)</p>\n    <p class=\"reference\">Haftarah: 1 Kings 3:15–4:1 | Brit Chadashah: Revelation 19:1–16<br>Psalm 126 and 10</p>\n  </section>\n\n  <!-- h1>Messianic Parashah Readings</h1>\n        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Torah • Haftarah • Brit Chadashah</p -->\n   \n\n  <!-- January 2026 -->\n  <!--section class=\"parashah\">\n    <h2>Dec 27 – Parashat #11 Vayigash (Gen 44:18–47:27)</h2>\n    <p><strong>Theme:</strong> Reconciliation and restoration</p>\n    <p class=\"connection\">Messianic Connection: Joseph reveals himself—foreshadowing Messiah’s revelation to Israel (Zechariah 12:10)</p>\n    <p class=\"reference\">Haftarah: Ezekiel 37:15–28 | Brit Chadashah: Luke 24:13–35<br>Psalm 11 &amp; 105<br>Mark 10</p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Jan 3 – Parashat #12 Vayechi (Gen 47:28–50:26)</h2> \n    <p><span class=\"hebrew\">חזק חזק ונתחזק </span><br><br>\n    <span class=\"bigger\">Hazak, hazak, v’nit’chazek!</span><br>\n    <span class=\"smaller\">Be strong, be strong, and let us be strengthened!</span></p>\n    <p><strong>Theme:</strong> Legacy and prophetic blessing</p>\n    <p class=\"connection\">Messianic Connection: Judah’s blessing points to the Lion of Judah (Genesis 49:10; Revelation 5:5)</p>\n    <p class=\"reference\">Haftarah: 1 Kings 2:1–12 | Brit Chadashah: Hebrews 11:21–22<br>Psalm 12 &amp; 145<br>Mark 11</p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Jan 10 – Parashat #13 Shemot (Exodus 1:1–6:1)</h2>\n    <p><strong>Theme:</strong> Bondage and calling</p>\n    <p class=\"connection\">Messianic Connection: Moses as a type of Messiah delivering from bondage (Acts 7:17–36)</p>\n    <p class=\"reference\">Haftarah: Isaiah 27:6–28:13 | Brit Chadashah: Matthew 2:13–23<br>Psalm 13 &amp; 34<br>Mark 12</p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Jan 17 – Parashat #14 Va’era (Exodus 6:2–9:35)</h2>\n    <p><strong>Theme:</strong> Divine power and covenant</p>\n    <p class=\"connection\">Messianic Connection: Signs and wonders confirm divine authority (John 10:37–38)</p>\n    <p class=\"reference\">Haftarah: Ezekiel 28:25–29:21 | Brit Chadashah: Revelation 15:1–4<br>Psalm 14 &amp; 77<br>Mark 13<br></p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Jan 24 – Parashat #15 Bo (Exodus 10:1–13:16)</h2>\n    <p><strong>Theme:</strong> Redemption and Passover</p>\n    <p class=\"connection\">Messianic Connection: Messiah as our Passover Lamb (1 Corinthians 5:7)</p>\n    <p class=\"reference\">Haftarah: Jeremiah 46:13–28 | Brit Chadashah: Luke 22:7–20<br>Psalm 15<br>Mark 14<br></p>\n  </section>\n\n  <!-- February 2026>\n  <section class=\"parashah\">\n    <h2>Jan 31 – Parashat #16 Beshalach (Exodus 13:17–17:16)</h2>\n    <p><strong>Theme:</strong> Deliverance and testing</p>\n    <p class=\"connection\">Messianic Connection: Crossing the sea as a symbol of new life in Messiah (Romans 6:3–4)</p>\n    <p class=\"reference\">Haftarah: Judges 4:4–5:31 | Brit Chadashah: John 6:1–15<br>Psalm 16<br>Mark 15<br></p>\n  </section -->\n\n  <!-- section class=\"parashah\">\n    <h2>Feb 7 – Parashat #17 Yitro (Exodus 18:1–20:23)</h2>\n    <p><strong>Theme:</strong> Revelation at Sinai</p>\n    <p class=\"connection\">Messianic Connection: Yeshua fulfills the Torah and teaches its heart (Matthew 5:17–48)</p>\n    <p class=\"reference\">Haftarah: Isaiah 6:1–7:6 | Brit Chadashah: Hebrews 12:18–24<br>Psalm 17<br>Mark 16<br></p>\n  </section -->\n\n  <!--section class=\"parashah\">\n    <h2>Feb 14 – Parashat #18 Mishpatim (Exodus 21:1–24:18)</h2>\n    <p><strong>Theme:</strong> Justice and covenant</p>\n    <p class=\"connection\">Messianic Connection: Messiah embodies divine justice and mercy (Matthew 23:23)</p>\n    <p class=\"reference\">Haftarah: Jeremiah 34:8–22 | Brit Chadashah: Romans 13:1–10<br>Psalm 18<br>Mark 16</p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Feb 21 – Parashat #19 Terumah (Exodus 25:1–27:19)</h2>\n    <p><strong>Theme:</strong> Sanctuary and presence</p>\n    <p class=\"connection\">Messianic Connection: Messiah as the true dwelling of God (John 1:14; Hebrews 9:11)</p>\n    <p class=\"reference\">Haftarah: 1 Kings 5:26–6:13 | Brit Chadashah: Revelation 21:1–3<br>Psalm 19<br></p>\n  </section -->\n\n  <!-- March 2026 -->\n  <section class=\"parashah\">\n    <h2>Feb 28 – Parashat #20 Tetzaveh (Exodus 27:20–30:10)</h2>\n    <p><strong>Theme:</strong> Priestly garments and consecration</p>\n    <p class=\"connection\">Messianic Connection: Yeshua as our High Priest clothed in righteousness (Hebrews 4:14–16)</p>\n    <p class=\"reference\">Haftarah: Ezekiel 43:10–27 | Brit Chadashah: Revelation 1:12–20<br>Psalm 20<br></p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Mar 7 – Parashat #21 Ki Tisa (Exodus 30:11–34:35)</h2>\n    <p><strong>Theme:</strong> Intercession and renewal</p>\n    <p class=\"connection\">Messianic Connection: Messiah intercedes and restores covenant (Hebrews 9:11–15)</p>\n    <p class=\"reference\">Haftarah: 1 Kings 18:1–39 | Brit Chadashah: 2 Corinthians 3:1–18<br>Psalm 21<br></p>\n  </section>\n<!-- h1>I am not sure</h1>\n        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">But Parsha's Vayakhel and Pekudei maybe combined this year.<br>If so, we will make the needed changes to the dates.</p -->\n  <section class=\"parashah\">\n    <h2>Mar 14 – Parashat #22 Vayakhel (Exodus 35:1–38:20)</h2>\n    <p><strong>Theme:</strong> Community and craftsmanship</p>\n    <p class=\"connection\">Messianic Connection: The body of Messiah builds the spiritual house (1 Peter 2:5)</p>\n    <p class=\"reference\">Haftarah: 1 Kings 7:40–50 | Brit Chadashah: Romans 12:4–8<br>Psalm 22<br></p>\n  </section>\n\n  <section class=\"parashah\">\n    <h2>Mar 21 – Parashat #23 Pekudei (Exodus 38:21–40:38)</h2>\n      <p><span class=\"hebrew\">חזק חזק ונתחזק </span><br><br>\n    <span class=\"bigger\">Hazak, hazak, v’nit’chazek!</span><br>\n    <span class=\"smaller\">Be strong, be strong, and let us be strengthened!</span></p>\n    <p><strong>Theme:</strong> Completion and glory</p>\n    <p class=\"connection\">Messianic Connection: Messiah completes the dwelling of God among us (John 17:4; Revelation 21:22–27)</p>\n      <p class=\"reference\">Haftarah: | Brit Chadashah:&nbsp;M’lakhim Alef (1 Kings) 7:51–8:21<br>Psalm 23<br> </p>\n  \n  <!-- Add more weekly sections here -->\n      \n </section>\n        <!--section class=\"parashah\">\n    <h2>Aug 16, 2025 – Parashat Ekev (Deuteronomy 7:12–11:25)</h2>\n    <p><strong>Theme:</strong> Blessings for obedience</p>\n    <p class=\"connection\">Messianic Connection: Yeshua echoes the call to wholehearted love and obedience (Matthew 22:37–40)</p>\n    <p class=\"reference\">Haftarah: Isaiah 49:14–51:3 | Brit Chadashah: Romans 8:31–39</p>\n  </section -->\n        \n        <!--section class=\"parashah\">\n    <h2>Aug 16, 2025 – Parashat Ekev (Deuteronomy 7:12–11:25)</h2>\n    <p><strong>Theme:</strong> Blessings for obedience</p>\n    <p class=\"connection\">Messianic Connection: Yeshua echoes the call to wholehearted love and obedience (Matthew 22:37–40)</p>\n    <p class=\"reference\">Haftarah: Isaiah 49:14–51:3 | Brit Chadashah: Romans 8:31–39</p>\n  </section -->\n        \n    <!--section class=\"parashah\">\n    <h2>Aug 16, 2025 – Parashat Ekev (Deuteronomy 7:12–11:25)</h2>\n    <p><strong>Theme:</strong> Blessings for obedience</p>\n    <p class=\"connection\">Messianic Connection: Yeshua echoes the call to wholehearted love and obedience (Matthew 22:37–40)</p>\n    <p class=\"reference\">Haftarah: Isaiah 49:14–51:3 | Brit Chadashah: Romans 8:31–39</p>\n  </section -->\n        <!--section class=\"parashah\">\n    <h2>Aug 16, 2025 – Parashat Ekev (Deuteronomy 7:12–11:25)</h2>\n    <p><strong>Theme:</strong> Blessings for obedience</p>\n    <p class=\"connection\">Messianic Connection: Yeshua echoes the call to wholehearted love and obedience (Matthew 22:37–40)</p>\n    <p class=\"reference\">Haftarah: Isaiah 49:14–51:3 | Brit Chadashah: Romans 8:31–39</p>\n  </section -->    \n    \n</div></section>",
          "_cid": "uTKL1uvc0u",
          "_anchor": "header02-3v",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            "p": {
              "line-height": "2"
            },
            "p a": {
              "&:hover": {
                "background": "none !important"
              }
            },
            ".row": {
              "align-items": "flex-end"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".btn-white": {
              "color": "@primaryColor !important"
            },
            "h1": {
              "font-weight": "500"
            },
            ".text-white": {
              "&:hover": {
                "color": "@secondaryColor !important"
              }
            },
            ".mbr-section-subtitle": {
              "background": "@primaryColor",
