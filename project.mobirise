        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<h1>Parsha Readings</h1>\n\n<div id=\"parsha-container\"></div>\n\n<style>\n  .parsha-card {\n    background: #ffffff;\n    border-radius: 1rem;\n    padding: 1.5rem;\n    margin: 1.5rem auto;\n    max-width: 900px;\n    box-shadow: 0 2px 6px rgba(0,0,0,0.2);\n  }\n\n  .parsha-date {\n    text-align: center;\n    font-style: italic;\n    margin-bottom: 0.5rem;\n  }\n\n  .hebrew {\n    font-weight: bold;\n    font-size: 275%;\n    text-align: center;\n  }\n\n  .bigger {\n    font-weight: bold;\n    font-size: 225%;\n    text-align: center;\n  }\n\n  p {\n    font-size: 120%;\n    line-height: 1.4;\n  }\n</style>\n\n[JS_CODE_0]",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-88",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\nwindow.onload = function() {\n\n  async function loadParshiot() {\n    const response = await fetch('parshiot.json');\n    const data = await response.json();\n    return data.parshiot; // B2 structure\n  }\n\n  function parseDate(str) {\n    const [mm, dd, yyyy] = str.split('-');\n    return new Date(yyyy, mm - 1, dd);\n  }\n\n  function findCurrentParsha(parshiot) {\n    const today = new Date();\n    today.setHours(0,0,0,0);\n\n    for (let p of parshiot) {\n      const pDate = parseDate(p.date);\n      if (pDate >= today) {\n        return p;\n      }\n    }\n    return parshiot[0];\n  }\n\n  function renderParsha(parsha) {\n    const container = document.getElementById('parsha-container');\n\n    container.innerHTML = `\n      <div class=\"parsha-card\">\n        <div class=\"parsha-date\">${parsha.date}</div>\n        <div class=\"hebrew\">${parsha.nameHe}</div>\n        <div class=\"bigger\">${parsha.nameEn}</div>\n\n        <p><strong>Torah:</strong> ${parsha.torah}</p>\n        <p><strong>Haftarah:</strong> ${parsha.haftarah}</p>\n        <p><strong>Brit Chadashah:</strong> ${parsha.brit}</p>\n      </div>\n    `;\n  }\n\n  loadParshiot()\n    .then(parshiot => {\n      const current = findCurrentParsha(parshiot);\n      renderParsha(current);\n    })\n    .catch(err => {\n      const container = document.getElementById('parsha-container');\n      container.innerHTML = '<p style=\"color:white;text-align:center;\">Error loading parshiot.json</p>';\n      console.error(err);\n    });\n\n};\n</script>"
          ]
        }
      ]
    },
