          "_name": "article03",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article3\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\">\n            <input type=\"color\" title=\"Color\" value=\"#e1e7e4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row  align-left {{contentAlign}}\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                    <div class=\"subtitle-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-idea mobi-mbri\"></span>\n                        <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>Info</b></h2>\n                    </div>\n                </div>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>אָבִינוּ שֶׁבַּשָּׁמַיִם </b></h1>\n\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\"><br>אָבִינוּ שֶׁבַּשָּׁמַיִם יִתְקַדַּשׁ שְׁמֶךָ׃\n                    <br>A-vi-nu she-bash-ah-ma-yim, yit-ka-dash she-meh-kha.<br>\n                    <br>תָּבֹא מַלְכוּתֶךָ יֵעָשֶׂה רְצוֹנְךָ בָּאָרֶץ כַּאֲשֶׁר נַעֲשָׂה בַשָּׁמָיִם׃\n                    <br>Tah-vo mal-khu-teh-kha ye’ah-seh r’ts-o-neh-khha ba’ah-rets ka’a-sher na’ah-sah vash-ah-mah-yim.<br> <br>תֶּן־לָנוּ הַיּוֹם לֶחֶם חֻקֵּנוּ׃\n                    <br>Ten-lay-nu hai-yom leh-chem chu-kei-nu.\n                    <br>\t\n                    <br>וּסְלַח־לָנוּ אֶת־אַשְׁמָתֵנוּ כַּאֲשֶׁר סֹלְחִים אֲנַחְנוּ לַאֲשֶׁר אָשְׁמוּ לָנוּ׃\n                    <br>u’se-lach-lay-nu et-ash-may-tei-nu ka’ah-sher so-lech-im a-na-choo-nu la’ah-sher ash-mu lah-nu.\n                    <br>\t\n                    <br>וְאַל־תְּבִיאֵנוּ לִידֵי מַסָּה כִּי אִם־הַצִּילֵנוּ מִן־הָרָע כִּי לְךָ\n                    <br>ve’al-teh-vey-e-nu ley-dei mas-sah ki im-hat-see-ley-nu min-ha-rah Ki la-cha\n                    <br>\n                    <br>הַמַּמְלָכָה וְהַגְּבוּרָה וְהַתִּפְאֶרֶת לְעוֹלְמֵי עוֹלָמִים אָמֵן\n                    <br>hah-mam-lah-cha veh-ha-gee-vu-rah vee-ha-ti-fey-ret l’o-lee-mee o-lah-mim. Amen\n\n                    <br><br>\n                </p>\n            </div>\n            <div class=\"col-lg-6\">\n\n                <p class=\"mbr-text2 mbr-fonts-style pb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text2, .mbr-section-btn\">\n                    <br><br>\n                    <br><br><br>Our Father in heaven! May Your name be kept holy.<br>\n                    <br>May Your Kingdom come, Your will be done on earth as in heaven.<br>\n                    <br>Give us the food we need today. <br><br>Forgive us what we have done wrong,&nbsp;<br>as we too have forgiven those have wronged us.<br>\n                    <br>And do not lead us into hard testing, but keep us safe from the evil one. \n                    <br><br>For kingship, power, and glory are Yours forever. Amen&nbsp;<br></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get\n                        Started</a> <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Read More</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uTzPWgiFUc",
          "_anchor": "article03-21",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
