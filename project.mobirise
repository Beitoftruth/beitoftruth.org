          "_name": "map01",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\"  class=\"map1\" group=\"Maps\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Map</header>\n        <input type=\"map\" title=\"Map\" name=\"googleMap\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" parallax=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#04492e\" selected=\"\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"mbr-section-head mb-4\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>Visit Us</b>\n            </h3>\n            <h4 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Find us here\n            </h4>\n        </div>\n        <div class=\"google-map\" mbr-map=\"googleMap\">\n        </div>\n    </div>\n</section>",
          "_cid": "tBnYUulbUC",
          "_anchor": "map01-h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "form .btn": {
              "border-radius": "2rem",
              "padding": "1rem 3rem"
            },
            "h1": {
              "font-weight": "500",
              "line-height": "1"
            },
            "& when (@customStyle)": {
              ".form-control, .field-input": {
                "padding": "1rem",
                "background-color": "@fieldColor",
                "border": "none !important",
                "border-radius": "0",
                "border-left": "2px solid @borderColor !important",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none",
                "&::-webkit-input-placeholder, &::-webkit-input-placeholder": {
                  "color": "@formPlaceholder"
                },
                "&:-moz-placeholder, &:-moz-placeholder": {
                  "color": "@formPlaceholder"
                },
                "&:hover, &:focus": {
                  "background-color": "@fieldHover",
                  "border-color": "@borderHover !important",
                  "color": "@formFocusText",
                  "box-shadow": "none",
                  "outline": "none",
                  "&::-webkit-input-placeholder, &::-webkit-input-placeholder": {
                    "color": "@formFocusPlaceholder"
                  },
                  "&:-moz-placeholder, &:-moz-placeholder": {
                    "color": "@formFocusPlaceholder"
                  }
                }
              },
              ".jq-number__spin:hover, .jq-number__spin:focus": {
                "background-color": "@fieldHover",
                "border-color": "@borderHover !important",
                "color": "contrast(@formText, #000000, #ffffff, 30%)",
                "box-shadow": "none",
                "outline": "none"
              },
              ".jq-number__spin": {
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none"
              },
              ".jq-selectbox li, .jq-selectbox li": {
                "background-color": "@fieldColor",
                "color": "contrast(@fieldColor, #000000, #ffffff, 30%)"
              },
              ".jq-selectbox li:hover, .jq-selectbox li.selected": {
                "background-color": "@fieldHover",
                "color": "contrast(@fieldHover, #000000, #ffffff, 30%)"
              },
              ".jq-selectbox:hover .jq-selectbox__trigger-arrow, .jq-number__spin.minus:hover:after, .jq-number__spin.plus:hover:after": {
                "border-top-color": "@fieldColor",
                "border-bottom-color": "@fieldColor"
              },
              ".jq-selectbox .jq-selectbox__trigger-arrow, .jq-number__spin.minus:after, .jq-number__spin.plus:after": {
                "border-top-color": "@fieldHover",
                "border-bottom-color": "@fieldHover"
              }
            },
            "textarea": {
              "min-height": "150px"
            },
            "& when (@customStyle), (@disableElements)": {
              "input::-webkit-clear-button": {
                "display": "none"
              },
              "input::-webkit-inner-spin-button": {
                "display": "none"
              },
              "input::-webkit-outer-spin-button": {
                "display": "none"
              },
              "input::-webkit-calendar-picker-indicator": {
                "display": "none"
              }
            },
            "LABEL": {
              "color": "#04492e"
            },
            ".col-auto": {
              "margin": "auto"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#04492e"
            }
          },
          "_name": "form02",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\"  class=\"form2\" group=\"Form\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Form Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"checkbox\" name=\"disableElements\" title=\"Disable Control\">\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#04492e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#04492e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formFocusText\" title=\"Text Focus\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#6e6e6e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formFocusPlaceholder\" title=\"Placeholders Focus\" value=\"#6e6e6e\" condition=\"customStyle\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\">\n            <input type=\"color\" title=\"Color\" value=\"#e1e7e4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row  align-left {{contentAlign}}\">\n\n\n            <div mbr-form class=\"col-lg-8 mx-auto mbr-form\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-5\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Contact Us</h1>\n                <!--Formbuilder Form-->\n                <form action name=\"Form Name\" method=\"POST\" data-rcpha_sitekey=\"\" data-rcpha_secretkey=\"\" class=\"mbr-form form-with-styler\" data-verified>\n                    <div class=\"row\">\n                        <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out\n                            the form!</div>\n                        <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some\n                            problem!</div>\n                    </div>\n                    <div class=\"dragArea row\">\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"name\" class=\"form-control-label mbr-fonts-style\">Full Name</label>\n                            <input type=\"text\" name=\"name\" placeholder=\"Enter your full name\" data-form-field=\"name\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"email\" class=\"form-control-label mbr-fonts-style\">Email</label>\n                            <input type=\"email\" name=\"email\" placeholder=\"Enter your email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" value>\n                        </div>\n                        <div data-for=\"phone\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"phone\" class=\"form-control-label mbr-fonts-style\">Phone number</label>\n                            <input type=\"tel\" name=\"phone\" placeholder=\"Enter your phone\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" pattern=\"*\" value>\n                        </div>\n                        <div data-for=\"message\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"message\" class=\"form-control-label mbr-fonts-style\">Message</label>\n                            <textarea name=\"message\" placeholder=\"Enter your message\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n                        </div>\n                        <div class=\"col-auto\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 btn btn-primary\" data-app-placeholder=\"Type Text\">Send Message</a></div>\n                    </div>\n                </form><!--Formbuilder Form-->\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "tBnYTBB2e3",
          "_anchor": "form02-g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "\n\n\n  <meta charset=\"UTF-8\">\n  <title>Parsha Readings March–October 2026</title>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }\n    h1 { text-align: center; }\n    .week { margin-bottom: 25px; padding: 10px; border-bottom: 1px solid #ccc; }\n    .date { font-weight: bold; color: #2a4d69; }\n    .theme { font-style: italic; color: #333; }\n  </style>\n\n\n  <h1>Parsha Readings (Diaspora) — March 7 to October 31, 2026</h1>\n\n  <div class=\"week\">\n    <div class=\"date\">March 7, 2026 — Parsha: Ki Tisa</div>\n    <div>Torah: Exodus 30:11–34:35</div>\n    <div>Haftarah (Sephardi): 1 Kings 18:1–39</div>\n    <div>Haftarah (Karaite): Ezekiel 36:16–38</div>\n    <div>Messianic Reading: 2 Corinthians 3:7–18</div>\n    <div class=\"theme\">Yeshua unveils the glory hidden behind the veil of Moses.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">March 14, 2026 — Parsha: Vayakhel–Pekudei</div>\n    <div>Torah: Exodus 35:1–40:38</div>\n    <div>Haftarah (Sephardi): 1 Kings 7:40–50</div>\n    <div>Haftarah (Karaite): Isaiah 66:1–24</div>\n    <div>Messianic Reading: Hebrews 9:1–14</div>\n    <div class=\"theme\">Yeshua as the greater High Priest who fulfills the Tabernacle’s purpose.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">March 21, 2026 — Parsha: Vayikra</div>\n    <div>Torah: Leviticus 1:1–5:26</div>\n    <div>Haftarah (Sephardi): Isaiah 43:21–44:23</div>\n    <div>Haftarah (Karaite): Jeremiah 7:21–8:3</div>\n    <div>Messianic Reading: Romans 12:1–2</div>\n    <div class=\"theme\">Yeshua calls us to present ourselves as living sacrifices.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">March 28, 2026 — Parsha: Tzav</div>\n    <div>Torah: Leviticus 6:1–8:36</div>\n    <div>Haftarah (Sephardi): Jeremiah 7:21–8:3</div>\n    <div>Haftarah (Karaite): Isaiah 57:14–58:14</div>\n    <div>Messianic Reading: Matthew 5:17–20</div>\n    <div class=\"theme\">Yeshua fulfills the Torah and deepens its meaning beyond ritual sacrifice.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">April 11, 2026 — Parsha: Shemini</div>\n    <div>Torah: Leviticus 9:1–11:47</div>\n    <div>Haftarah (Sephardi): 2 Samuel 6:1–7:17</div>\n    <div>Haftarah (Karaite): Ezekiel 36:16–38</div>\n    <div>Messianic Reading: Mark 7:14–23</div>\n    <div class=\"theme\">Yeshua teaches purity of heart over ritual purity laws.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">April 18, 2026 — Parsha: Tazria–Metzora</div>\n    <div>Torah: Leviticus 12:1–15:33</div>\n    <div>Haftarah (Sephardi): 2 Kings 7:3–20</div>\n    <div>Haftarah (Karaite): Isaiah 52:1–12</div>\n    <div>Messianic Reading: Luke 17:11–19</div>\n    <div class=\"theme\">Yeshua heals the lepers, embodying cleansing beyond ritual law.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">April 25, 2026 — Parsha: Achrei Mot–Kedoshim</div>\n    <div>Torah: Leviticus 16:1–20:27</div>\n    <div>Haftarah (Sephardi): Amos 9:7–15</div>\n    <div>Haftarah (Karaite): Ezekiel 22:1–31</div>\n    <div>Messianic Reading: Hebrews 10:1–25</div>\n    <div class=\"theme\">Yeshua’s sacrifice fulfills Yom Kippur and calls us to holiness.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">May 2, 2026 — Parsha: Emor</div>\n    <div>Torah: Leviticus 21:1–24:23</div>\n    <div>Haftarah (Sephardi): Ezekiel 44:15–31</div>\n    <div>Haftarah (Karaite): Isaiah 56:1–8</div>\n    <div>Messianic Reading: John 10:22–30</div>\n    <div class=\"theme\">Yeshua as the Good Shepherd during the Feast of Dedication.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">May 9, 2026 — Parsha: Behar–Bechukotai</div>\n    <div>Torah: Leviticus 25:1–27:34</div>\n    <div>Haftarah (Sephardi): Jeremiah 32:6–27</div>\n    <div>Haftarah (Karaite): Ezekiel 34:1–31</div>\n    <div>Messianic Reading: Luke 4:16–21</div>\n    <div class=\"theme\">Yeshua proclaims Jubilee freedom in Nazareth.</div>\n  </div>\n\n  <!-- Continue pattern for each Shabbat through October 31, 2026 -->\n  <div class=\"week\">\n    <div class=\"date\">October 31, 2026 — Parsha: Bereshit</div>\n    <div>Torah: Genesis 1:1–6:8</div>\n    <div>Haftarah (Sephardi): Isaiah 42:5–43:10</div>\n    <div>Haftarah (Karaite): Isaiah 45:1–25</div>\n    <div>Messianic Reading: John 1:1–18</div>\n    <div class=\"theme\">Yeshua as the Word present at creation, bringing light and life.</div>\n  </div>\n\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-81",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            "p": {
              "line-height": "2"
            },
            "p a": {
              "&:hover": {
                "background": "none !important"
              }
            },
            ".row": {
              "align-items": "flex-end"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".btn-white": {
              "color": "@primaryColor !important"
            },
            "h1": {
              "font-weight": "500"
            },
            ".text-white": {
              "&:hover": {
                "color": "@secondaryColor !important"
              }
            },
            ".mbr-section-subtitle": {
              "background": "@primaryColor",
              "color": "#ffffff",
              "width": "fit-content",
              "border-radius": "2rem",
              "padding": "5px 1rem",
              "text-align": "left"
            },
            ".subtitle-wrap": {
              "display": "inline-flex",
              "border-radius": "2rem",
              "padding": "0.5rem",
              "padding-bottom": "0",
              "background": "@secondaryColor",
              "flex-direction": "row",
              "width": "fit-content",
              "align-items": "center",
              "margin-bottom": "2rem",
              ".mbr-iconfont": {
                "padding": "0 15px",
                "padding-bottom": "8px",
                "margin": "0",
                "color": "@primaryColor",
                "font-size": "1.5rem"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#fafaf9"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#cdfb0a"
            }
