          "_name": "features01",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\"  class=\"features1\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"range\" inline=\"\" title=\"Card\" name=\"card\" min=\"1\" max=\"2\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <header>Color</header>\n        <input type=\"color\" title=\"Card\" name=\"bgCard\" value=\"#033b25\">\n\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#04492e\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-left justify-content-center\">\n\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"wrapper\">\n                    <h5 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><b>Management</b></h5>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">Lorem\n                        ipsum dolor sit amet, consectetur adipiscing elit. Donec orci neque, elementum euismod porttitor\n                        vehicula, placerat a malesuada elit.</p>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-6\" mbr-if=\"card > 1\">\n                <div class=\"wrapper\">\n                    <h5 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                        <b>Promotion</b>\n                    </h5>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">Lorem\n                        ipsum dolor sit amet, consectetur adipiscing elit. Donec orci neque, elementum euismod porttitor\n                        vehicula, placerat a malesuada elit.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
