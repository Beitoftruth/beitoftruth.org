                "font-size": "1.5rem"
              }
            },
            ".mbr-section-title": {
              "color": "#04492e"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#6e6e6e"
            },
            ".mbr-section-subtitle, .align-wrapper": {
              "color": "#04492e"
            },
            ".mbr-section-title2": {
              "color": "#04492e"
