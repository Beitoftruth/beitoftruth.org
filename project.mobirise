          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features7\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showmainTitle\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"color\" title=\"Subtitle BG\" name=\"subtitleBg\" value=\"#CCE3DE\" selected condition=\"showSubitle\">\n        <input type=\"color\" title=\"Subtitle Frame\" name=\"subtitleFrame\" value=\"#A4C3B2\" selected condition=\"showSubitle\">\n        <input type=\"color\" title=\"Subtitle Icon\" name=\"subtitleIcon\" value=\"#000000\" selected condition=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n         <input type=\"color\" title=\"Border\" name=\"frameColor\" value=\"#CCE3DE\" selected>\n         <input type=\"checkbox\" name=\"autoSize\" title=\"Image Auto Size\" checked>\n\t\t<input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"2\" condition=\"autoSize\">&gt;\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fafaf9\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-left justify-content-center\">\n            <div class=\"col-12\">\n\n\n                <h2 class=\"mbr-section-maintitle mbr-fonts-style pb-5\" mbr-if=\"showmainTitle\" data-app-selector=\".mbr-section-maintitle\" mbr-theme-style=\"display-2\"><b>Our Features</b></h2>\n            </div>\n\n            <div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"card-wrapper item-wrapper\">\n                    <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                        <div class=\"subtitle-wrap\">\n                            <h2 class=\"mbr-section-subtitle2 mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle2, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>\n\n                                    Step 1</b></h2>\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                            <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>1 weeks</b></h2>\n                        </div>\n                    </div>\n                    <!--div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/photo-1509580357930-a711cf9d888d.webp\" alt=\"Mobirise Website Builder\">\n                    </div -->\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Mission</h1>\n\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">To cultivate authentic discipleship by restoring the teachings of Yeshua and the Torah as the foundation for life and community.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Join Us</a></div>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"card-wrapper item-wrapper\">\n                    <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                        <div class=\"subtitle-wrap\">\n                            <h2 class=\"mbr-section-subtitle2 mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle2, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>\n\n                                    Step 1</b></h2>\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                            <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>1 weeks</b></h2>\n                        </div>\n                    </div>\n                    <!-- div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/photo-1438232992991-995b7058bbb3.webp\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"2\">\n                    </div -->\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Vision</h1>\n\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">To awaken trust in Yeshua across the world, and to embody that trust through acts of goodness and a life shaped by Torah.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Join Us</a></div>\n                </div>\n            </div><div class=\"col-12 col-lg-4 item features-without-image\">\n                <div class=\"card-wrapper item-wrapper\">\n                    <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                        <div class=\"subtitle-wrap\">\n                            <h2 class=\"mbr-section-subtitle2 mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle2, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>\n\n                                    Step 1</b></h2>\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                            <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>1 weeks</b></h2>\n                        </div>\n                    </div>\n                    <!--div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/photo-1742632661203-3d0decc0fda0.webp\" alt=\"Mobirise Website Builder\" data-slide-to=\"3\" data-bs-slide-to=\"2\">\n                    </div -->\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">How We Live</h1>\n\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">We live by a few words, \"Love your neighbor as yourself.\" </p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Join Us</a></div>\n                </div>\n            </div>\n\n\n\n\n        </div>\n    </div>\n</section>",
