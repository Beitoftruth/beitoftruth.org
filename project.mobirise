            },
            ".subtitle-wrap": {
              "display": "inline-flex",
              "border-radius": "2rem",
              "padding": "0.5rem",
              "padding-bottom": "0",
              "padding-left": "20px",
              "background": "@subtitleFrame",
              "flex-direction": "row",
              "width": "fit-content",
