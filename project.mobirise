          "_name": "pricing01",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\"  group=\"Pricing\" class=\"pricing1\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <select title=\"Amount\" name=\"itemsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Color</header>\n        <input type=\"color\" name=\"icon\" title=\"Icon\" value=\"#fb7a64\" selected>\n        <input type=\"color\" name=\"card\" title=\"Card BG\" value=\"#ffffff\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\">\n            <input type=\"color\" title=\"Color\" value=\"#e1e7e4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-md-12 pb-5\" mbr-if=\"showTitle || showSubtitle\">\n                <h3 class=\"mbr-section-title mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                    <b>PRICING</b>\n                </h3>\n                <h4 class=\"mbr-section-subtitle mb-0 mt-2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">Lorem ipsum dolor sit amet</h4>\n            </div>\n\n        </div>\n        <div class=\"row row-color justify-content-center\">\n\n            <div class=\"col-12 col-md-12 card align-center\" mbr-if=\"itemsAmount > 0\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-12': itemsAmount == 1}\">\n                <div class=\"plan\">\n                    <div class=\"plan-header align-left\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-tablet-vertical mobi-mbri\"></span>\n                        <h6 class=\"plan-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".plan-title\">Small site</h6>\n                        <div class=\"plan-price\">\n\n                            <span mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price, .plan-price\"><b>$199</b></span>\n                            <span mbr-text class=\"price-term mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".price-term, .plan-price\">USD</span>\n                        </div>\n                        <p class=\"mbr-card-text mb-4 mt-2 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-card-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consect\n                            adipiscing elit. Vivamus lobortis and sapien. Etiam ante sapien viverra consequat viverra\n                            venenatis.&nbsp;</p>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mb-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">Get started</a></div>\n\n                        <hr>\n\n                    </div>\n                    <div class=\"plan-body mt-4\">\n                        <div class=\"plan-list\">\n                            <ul mbr-text class=\"list-group mbr-fonts-style list-group-flush\" data-app-selector=\".list-group-item\" mbr-theme-style=\"display-4\">\n                                <li class=\"list-group-item\">Web Design</li>\n                                <li class=\"list-group-item\">Development</li>\n                                <li class=\"list-group-item\">Content</li>\n                                <li class=\"list-group-item\">Integration</li>\n                                <li class=\"list-group-item\">Optimization</li>\n                                <li class=\"list-group-item\"><span style=\"background-color: transparent; font-size: 1.2rem;\">Support</span><br>\n                                </li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-12 card align-center\" mbr-if=\"itemsAmount > 1\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-12': itemsAmount == 1}\">\n                <div class=\"plan\">\n                    <div class=\"plan-header align-left\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-devices mobi-mbri\"></span>\n                        <h6 class=\"plan-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".plan-title\">Medium site</h6>\n                        <div class=\"plan-price\">\n\n                            <span mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price, .plan-price\"><b>$399</b></span>\n                            <span mbr-text class=\"price-term mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".price-term, .plan-price\">USD</span>\n                        </div>\n                        <p class=\"mbr-card-text mb-4 mt-2 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-card-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consect\n                            adipiscing elit. Vivamus lobortis and sapien. Etiam ante sapien viverra consequat viverra\n                            venenatis.<br> </p>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mb-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">Get started</a></div>\n\n                        <hr>\n\n                    </div>\n                    <div class=\"plan-body mt-4\">\n                        <div class=\"plan-list\">\n                            <ul mbr-text class=\"list-group mbr-fonts-style list-group-flush\" data-app-selector=\".list-group-item\" mbr-theme-style=\"display-4\">\n                                <li class=\"list-group-item\">Web Design</li>\n                                <li class=\"list-group-item\">Development</li>\n                                <li class=\"list-group-item\">Content</li>\n                                <li class=\"list-group-item\">Integration</li>\n                                <li class=\"list-group-item\">Optimization</li>\n                                <li class=\"list-group-item\"><span style=\"background-color: transparent; font-size: 1.2rem;\">Support</span><br>\n                                </li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-12 card align-center\" mbr-if=\"itemsAmount > 2\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-12': itemsAmount == 1}\">\n                <div class=\"plan\">\n                    <div class=\"plan-header align-left\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-desktop mobi-mbri\"></span>\n                        <h6 class=\"plan-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".plan-title\">Large site</h6>\n                        <div class=\"plan-price\">\n\n                            <span mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price, .plan-price\"><b>$699</b></span>\n                            <span mbr-text class=\"price-term mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".price-term, .plan-price\">USD</span>\n                        </div>\n                        <p class=\"mbr-card-text mb-4 mt-2 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-card-text, .mbr-section-btn\">Lorem ipsum dolor sit amet, consect\n                            adipiscing elit. Vivamus lobortis and sapien. Etiam ante sapien viverra consequat viverra\n                            venenatis. </p>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mb-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">Get started</a></div>\n\n                        <hr>\n\n                    </div>\n                    <div class=\"plan-body mt-4\">\n                        <div class=\"plan-list\">\n                            <ul mbr-text class=\"list-group mbr-fonts-style list-group-flush\" data-app-selector=\".list-group-item\" mbr-theme-style=\"display-4\">\n                                <li class=\"list-group-item\">Web Design</li>\n                                <li class=\"list-group-item\">Development</li>\n                                <li class=\"list-group-item\">Content</li>\n                                <li class=\"list-group-item\">Integration</li>\n                                <li class=\"list-group-item\">Optimization</li>\n                                <li class=\"list-group-item\"><span style=\"background-color: transparent; font-size: 1.2rem;\">Support</span><br>\n                                </li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "tBnYSEdU9n",
          "_anchor": "pricing01-f",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "\n\n\n  <meta charset=\"UTF-8\">\n  <title>Parsha Readings March–October 2026</title>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }\n    h1 { text-align: center; }\n    .week { margin-bottom: 25px; padding: 10px; border-bottom: 1px solid #ccc; }\n    .date { font-weight: bold; color: #2a4d69; }\n    .theme { font-style: italic; color: #333; }\n  </style>\n\n\n  <h1>Parsha Readings (Diaspora) — March 7 to October 31, 2026</h1>\n\n  <div class=\"week\">\n    <div class=\"date\">March 7, 2026 — Parsha: Ki Tisa</div>\n    <div>Torah: Exodus 30:11–34:35</div>\n    <div>Haftarah (Sephardi): 1 Kings 18:1–39</div>\n    <div>Haftarah (Karaite): Ezekiel 36:16–38</div>\n    <div>Messianic Reading: 2 Corinthians 3:7–18</div>\n    <div class=\"theme\">Yeshua unveils the glory hidden behind the veil of Moses.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">March 14, 2026 — Parsha: Vayakhel–Pekudei</div>\n    <div>Torah: Exodus 35:1–40:38</div>\n    <div>Haftarah (Sephardi): 1 Kings 7:40–50</div>\n    <div>Haftarah (Karaite): Isaiah 66:1–24</div>\n    <div>Messianic Reading: Hebrews 9:1–14</div>\n    <div class=\"theme\">Yeshua as the greater High Priest who fulfills the Tabernacle’s purpose.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">March 21, 2026 — Parsha: Vayikra</div>\n    <div>Torah: Leviticus 1:1–5:26</div>\n    <div>Haftarah (Sephardi): Isaiah 43:21–44:23</div>\n    <div>Haftarah (Karaite): Jeremiah 7:21–8:3</div>\n    <div>Messianic Reading: Romans 12:1–2</div>\n    <div class=\"theme\">Yeshua calls us to present ourselves as living sacrifices.</div>\n  </div>\n\n  <div class=\"week\">\n    <div class=\"date\">March 28, 2026 — Parsha: Tzav</div>\n    <div>Torah: Leviticus 6:1–8:36</div>\n    <div>Haftarah (Sephardi): Jeremiah 7:21–8:3</div>\n    <div>Haftarah (Karaite): Isaiah 57:14–58:14</div>\n    <div>Messianic Reading: Matthew 5:17–20</div>\n    <div class=\"theme\">Yeshua fulfills the Torah and deepens its meaning beyond ritual sacrifice.</div>\n  </div>\n\n  <!-- Continue this pattern for each Shabbat up to October 31, 2026 -->\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-7z",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".google-map": {
