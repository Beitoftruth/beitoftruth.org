          "_name": "contacts01",
          "_sourceTheme": "discretem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contact1\" group=\"Contact\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubitle\">\n        <input type=\"checkbox\" title=\"Links\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#04492e\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-left {{contentAlign}}\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"align-wrapper\" mbr-if=\"showSubitle\">\n                    <div class=\"subtitle-wrap\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-edit-2 mobi-mbri\"></span>\n                        <h2 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .align-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showSubitle\"><b>\n\n                                Contact</b></h2>\n                    </div>\n                </div>\n                \n             </div>\n            <div class=\"mbr-section-head pb-4\">\n            <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Daily Prayers And Count Your Blessings</b></h4>\n             <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"calendar.html#custom-calendar-1\" data-app-placeholder=\"Type Text\">Calendar</a> <a class=\"btn btn-primary\" href=\"gratitude.html\" data-app-placeholder=\"Type Text\">Count Your Blessings</a> <a class=\"btn btn-primary\" href=\"page11.html\" data-app-placeholder=\"Type Text\">Prayers For Israel</a><a class=\"btn btn-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Home</a></div>\n        </div>\n            <div class=\"col-lg-6 mt-5\">\n                 \n                <!--p class=\"mbr-text align-right mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">LinkedIn\n                    <br><a href=\"#\" class=\"text-white\">Twitter</a>\n                    <br><a href=\"#\" class=\"text-white\">Instagram</a>\n                LinkedIn\n                    <br><a href=\"#\" class=\"text-white\">Twitter</a>\n                    <br><a href=\"#\" class=\"text-white\">Instagram</a>\n                </p -->\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "contacts01-5n",
          "_isUserblock": true,
          "_cid": "uTMZxPa910",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "  <meta charset=\"UTF-8\">\n  <title>Parsha Readings</title>\n  <style>\n    H1 { color: #ffffff; text-align: center; }\n    P { color: #000000; text-align: center; }\n    .bigger { font-weight: bold; font-size: 225%; text-align: center; }\n    .smaller { font-weight: bold; font-size: 175%; text-align: center; }\n    .hebrew { font-weight: bold; font-size: 275%; text-align: center; }\n\n    .parsha-card {\n      background: #ffffff;\n      border-radius: 1rem;\n      padding: 1rem;\n      margin: 1rem auto;\n      max-width: 900px;\n      box-shadow: 0 2px 6px rgba(0,0,0,0.1);\n    }\n    .parsha-date {\n      text-align: center;\n      font-style: italic;\n      margin-bottom: 0.5rem;\n    }\n    .parsha-section-title {\n      font-weight: bold;\n      margin-top: 0.5rem;\n      text-align: left;\n    }\n    .parsha-questions {\n      text-align: left;\n    }\n  </style>\n\n\n\n  <h1>Parsha Readings</h1>\n  <div id=\"parsha-container\"></div>\n\n  [JS_CODE_0]\n\n",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "discretem5",
          "_anchor": "custom-html-8b",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n    // Psalm anchor: Shabbat 2026-03-14 = Psalm 22\n    const psalmAnchorDate = new Date('2026-03-14T00:00:00');\n    const psalmAnchorNumber = 22;\n\n    function getPsalmForParsha(shabbatDate) {\n      const msPerWeek = 7 * 24 * 60 * 60 * 1000;\n      const diffMs = shabbatDate.getTime() - psalmAnchorDate.getTime();\n      const weeksDiff = Math.round(diffMs / msPerWeek);\n\n      let psalmNumber = psalmAnchorNumber + weeksDiff;\n      while (psalmNumber > 150) psalmNumber -= 150;\n      while (psalmNumber < 1) psalmNumber += 150;\n\n      return `Psalm ${psalmNumber}`;\n    }\n\n    async function loadParshiot() {\n      const res = await fetch('parshiot.json');\n      return await res.json();\n    }\n\n    function getWeekIndex(parshiot) {\n      const today = new Date();\n      const d = new Date(today.getFullYear(), today.getMonth(), today.getDate());\n\n      for (let i = 0; i < parshiot.length; i++) {\n        const shabbat = new Date(parshiot[i].date + 'T00:00:00');\n        const weekStart = new Date(shabbat);\n        weekStart.setDate(weekStart.getDate() - 6); // Sunday before\n        const nextWeekStart = new Date(weekStart);\n        nextWeekStart.setDate(nextWeekStart.getDate() + 7);\n\n        if (d >= weekStart && d < nextWeekStart) return i;\n      }\n      return 0;\n    }\n\n    function renderParshiot(parshiot) {\n      const container = document.getElementById('parsha-container');\n      container.innerHTML = '';\n\n      const idx = getWeekIndex(parshiot);\n      const start = Math.max(0, idx - 1);\n      const end = Math.min(parshiot.length - 1, idx + 2);\n\n      for (let i = start; i <= end; i++) {\n        const p = parshiot[i];\n        const shabbat = new Date(p.date + 'T00:00:00');\n        const psalmLabel = getPsalmForParsha(shabbat);\n\n        const card = document.createElement('div');\n        card.className = 'parsha-card';\n\n        card.innerHTML = `\n          <div class=\"parsha-date\">\n            ${shabbat.toLocaleDateString(undefined, {\n              year: 'numeric', month: 'short', day: 'numeric'\n            })}\n          </div>\n          <div class=\"bigger\">Parashat ${p.nameEn}</div>\n          <div class=\"hebrew\">${p.nameHe}</div>\n\n          <p class=\"parsha-section-title\">Theme</p>\n          <p>${p.theme}</p>\n\n          <p class=\"parsha-section-title\">Torah</p>\n          <p>${p.torah}</p>\n\n          <p class=\"parsha-section-title\">Haftarah</p>\n          <p>${p.haftarah}</p>\n\n          <p class=\"parsha-section-title\">Brit Chadashah (Apostolic Writings)</p>\n          <p>${p.brit}</p>\n\n          <p class=\"parsha-section-title\">Psalm</p>\n          <p>${psalmLabel}</p>\n\n          <p class=\"parsha-section-title\">Connection with Yeshua</p>\n          <p>${p.yeshuaConnection}</p>\n\n          <p class=\"parsha-section-title\">Questions</p>\n          <ul class=\"parsha-questions\">\n            ${p.questions.map(q => `<li>${q}</li>`).join('')}\n          </ul>\n        `;\n\n        container.appendChild(card);\n      }\n    }\n\n    function scheduleUpdate(parshiot) {\n      const now = new Date();\n      const next = new Date(now);\n      next.setHours(0, 0, 0, 0);\n      if (next <= now) next.setDate(next.getDate() + 1);\n      while (next.getDay() !== 0) next.setDate(next.getDate() + 1); // Sunday\n      const ms = next - now;\n\n      setTimeout(() => {\n        renderParshiot(parshiot);\n        scheduleUpdate(parshiot);\n      }, ms);\n    }\n\n    loadParshiot().then(parshiot => {\n      renderParshiot(parshiot);\n      scheduleUpdate(parshiot);\n    });\n  </script>"
          ]
        },
