        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "margin-top": "-1px",
            "overflow": "hidden",
            "border-bottom": "1px solid #7f8678",
            "border-top": "1px solid #7f8678",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".wrapper": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "flex-wrap": "wrap"
            },
            ".copyright": {
              "margin-top": "0.5rem",
              "color": "#ffffff",
              "flex-grow": "1",
              "margin-right": "0.5rem"
            },
            ".produced": {
              "margin-top": "0.5rem",
