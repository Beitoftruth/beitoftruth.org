              "border-radius": "2rem"
            },
            ".mbr-section-subtitle": {
              "background": "@subtitleBg",
              "width": "fit-content",
              "border-radius": "2rem",
              "padding": "5px 1rem",
              "text-align": "left"
            },
            ".subtitle-wrap": {
              "display": "inline-flex",
              "border-radius": "2rem",
              "padding": "0.5rem",
              "padding-bottom": "0",
              "background": "@subtitleFrame",
              "flex-direction": "row",
              "width": "fit-content",
              "align-items": "center",
              "margin-bottom": "2rem",
              ".mbr-iconfont": {
