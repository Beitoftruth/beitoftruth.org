<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Beit of Truth – Modern Ministry Grid</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

<style>
:root {
  --bg-light: #ffffff;
  --bg-soft: #f5f7fa;
  --bg-gradient: linear-gradient(135deg, #eef2f7, #ffffff);
  --text-dark: #2b2b2b;
  --text-soft: #555;
  --accent-blue: #4C8BF5;
  --accent-blue-dark: #2f6fe0;
  --accent-silver: #d9d9d9;
  --max-width: 1200px;
  --radius: 14px;
  --transition: 280ms ease;
}

/* Reset */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: "Inter", sans-serif;
  background: var(--bg-soft);
  color: var(--text-dark);
  line-height: 1.6;
}

/* Header */
header {
  background: var(--bg-gradient);
  padding: 1.2rem 1.5rem;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.header-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-family: "Playfair Display", serif;
  font-size: 1.6rem;
  font-weight: 600;
  letter-spacing: 0.03em;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 1.4rem;
}

nav a {
  text-decoration: none;
  color: var(--text-dark);
  font-weight: 500;
  position: relative;
}

nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -3px;
  width: 0;
  height: 2px;
  background: var(--accent-blue);
  transition: width var(--transition);
}

nav a:hover::after {
  width: 100%;
}

/* Hero */
.hero {
  padding: 4rem 1.5rem;
  background: var(--bg-gradient);
}

.hero-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  text-align: center;
}

.hero-title {
  font-family: "Playfair Display", serif;
  font-size: 2.4rem;
  margin-bottom: 1rem;
}

.hero-subtitle {
  font-size: 1.1rem;
  color: var(--text-soft);
  max-width: 700px;
  margin: 0.5rem auto 2rem;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 1rem;
}

.btn {
  padding: 0.7rem 1.6rem;
  border-radius: 999px;
  border: none;
  cursor: pointer;
  font-weight: 500;
  transition: background var(--transition), transform var(--transition);
}

.btn-blue {
  background: var(--accent-blue);
  color: #fff;
}

.btn-blue:hover {
  background: var(--accent-blue-dark);
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent;
  border: 2px solid var(--accent-blue);
  color: var(--accent-blue);
}

.btn-outline:hover {
  background: var(--accent-blue);
  color: #fff;
}

/* Section */
section {
  padding: 3.5rem 1.5rem;
}

.section-inner {
  max-width: var(--max-width);
  margin: 0 auto;
}

.section-title {
  font-family: "Playfair Display", serif;
  font-size: 1.8rem;
  margin-bottom: 1.5rem;
}

/* Card Grid */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.card {
  background: var(--bg-light);
  border-radius: var(--radius);
  padding: 1.4rem;
  box-shadow: 0 8px 20px rgba(0,0,0,0.06);
  transition: transform var(--transition), box-shadow var(--transition);
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(0,0,0,0.1);
}

.card-title {
  font-family: "Playfair Display", serif;
  font-size: 1.2rem;
  margin-bottom: 0.6rem;
}

.card-text {
  font-size: 0.95rem;
  color: var(--text-soft);
  margin-bottom: 1rem;
}

.card-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--accent-blue);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
}

/* Media Slider */
.slider {
  display: flex;
  overflow-x: auto;
  gap: 1rem;
  padding-bottom: 0.5rem;
}

.slider::-webkit-scrollbar {
  height: 6px;
}

.slider::-webkit-scrollbar-thumb {
  background: var(--accent-blue);
  border-radius: 999px;
}

.media-card {
  min-width: 260px;
  background: var(--bg-light);
  border-radius: var(--radius);
  padding: 1rem;
  box-shadow: 0 6px 16px rgba(0,0,0,0.06);
}

.media-thumb {
  width: 100%;
  height: 150px;
  background: var(--accent-silver);
  border-radius: var(--radius);
  margin-bottom: 0.8rem;
}

/* Footer */
footer {
  background: var(--bg-gradient);
  padding: 2rem 1.5rem;
  margin-top: 2rem;
  border-top: 1px solid rgba(0,0,0,0.06);
}

.footer-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  text-align: center;
}

.footer-text {
  font-size: 0.9rem;
  color: var(--text-soft);
}

@media (max-width: 800px) {
  nav ul { display: none; }
}
</style>
</head>

<body>

